# Copy to .env and fill in values. Never commit .env.

# Public site URL (canonical, RSS, sitemap). Use https in production.
BASE_URL=http://localhost:3000

# Required in production (NODE_ENV=production): random string, 24+ characters.
SESSION_SECRET=change-this-to-a-long-random-string

# Required in production. Keep true when HTTPS terminates at a trusted reverse proxy.
SESSION_COOKIE_SECURE=false

# Explicit reverse-proxy trust. Use 1 behind exactly one trusted proxy; use false for direct traffic.
# Never use true: it lets clients spoof forwarding headers when the proxy chain is not controlled.
TRUST_PROXY=false

# Admin API password (plain text in env — restrict file permissions on the server).
ADMIN_PASSWORD=

# Optional: absolute or relative path to SQLite file (default: database/aeoleaf.db).
# DATABASE_PATH=
# Back up the .db file regularly when deploying (copy while app is stopped, or after flush).

# Optional: set to 1 to send Content-Security-Policy-Report-Only headers (tune before enforcing).
# HELMET_CSP_REPORT_ONLY=1

# Production checklist: HTTPS BASE_URL, secure cookie, explicit TRUST_PROXY, and strong secrets above.
# NODE_ENV=production
