<% if (typeof isBirthday !== 'undefined' && isBirthday) { %>
<div class="birthday-banner">
  <span class="birthday-banner__emoji">🎂</span>
  <span>Happy Birthday! 今天是我的生日 🎉</span>
  <a href="/guestbook" class="birthday-banner__link">去留言祝福</a>
  <button class="birthday-banner__close" aria-label="关闭">✕</button>
</div>
<div class="birthday-decorations" aria-hidden="true"></div>
<div class="birthday-cake" role="button" aria-label="许个愿吧">
  <div class="birthday-cake__body">
    <div class="birthday-cake__layer birthday-cake__layer--bottom"></div>
    <div class="birthday-cake__layer birthday-cake__layer--top"></div>
    <div class="birthday-cake__candles">
      <div class="birthday-candle"><div class="birthday-flame"></div></div>
      <div class="birthday-candle"><div class="birthday-flame"></div></div>
      <div class="birthday-candle"><div class="birthday-flame"></div></div>
    </div>
  </div>
  <div class="birthday-cake__tip birthday-cake__tip--ask">🕯️ 点击许个愿吧</div>
  <div class="birthday-cake__tip birthday-cake__tip--done">✨ 愿望已许下</div>
</div>
<% } %>
<a href="#main" class="skip-link">跳到主要内容</a>
<div id="pjax-progress" class="pjax-progress" aria-hidden="true"></div>
<%- include('icons-sprite') %>
<header class="site-header">
  <nav class="nav-container" aria-label="主导航">
    <a href="/" class="nav-logo">
      <span>Aeoleaf <span class="nav-logo-zh">风叶</span></span>
    </a>
    <div class="nav-right">
      <ul class="nav-links" id="site-nav-links">
        <li><a href="/blog"><span class="nav-link__en">Blog</span><span class="nav-link__zh">博客文章</span></a></li>
        <li><a href="/works"><span class="nav-link__en">Works</span><span class="nav-link__zh">作品集</span></a></li>
        <li><a href="/about"><span class="nav-link__en">About</span><span class="nav-link__zh">关于我</span></a></li>
        <li class="nav-drawer-foot">
          <span class="nav-drawer-foot__links">
            <a href="/rss.xml" aria-label="RSS 订阅"><svg class="nav-icon" width="18" height="18" aria-hidden="true"><use href="#icon-rss"/></svg></a>
            <a href="https://github.com/Cnn77421" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg class="nav-icon" width="18" height="18" aria-hidden="true"><use href="#icon-github"/></svg></a>
            <a href="mailto:xiner521@aliyun.com" aria-label="邮箱"><svg class="nav-icon" width="18" height="18" aria-hidden="true"><use href="#icon-mail"/></svg></a>
          </span>
          <span class="nav-drawer-foot__copy">aeoleaf · 风叶</span>
        </li>
      </ul>
      <button type="button" id="search-toggle" class="search-toggle" aria-label="打开搜索" aria-expanded="false" aria-controls="search-modal">
        <svg class="nav-icon" width="20" height="20" aria-hidden="true"><use href="#icon-search"/></svg>
      </button>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="切换深色或浅色主题">
        <svg class="nav-icon" width="20" height="20" aria-hidden="true"><use href="#icon-theme"/></svg>
      </button>
      <button type="button" class="nav-toggle" aria-label="打开或关闭菜单" aria-expanded="false" aria-controls="site-nav-links">
        <svg class="nav-icon nav-icon--menu" width="24" height="24" aria-hidden="true"><use href="#icon-menu"/></svg>
        <svg class="nav-icon nav-icon--close" width="24" height="24" aria-hidden="true"><use href="#icon-close"/></svg>
      </button>
    </div>
  </nav>
</header>
<div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-labelledby="search-modal-title" aria-hidden="true">
  <div class="search-modal-content">
    <h2 id="search-modal-title" class="visually-hidden" tabindex="-1">搜索</h2>
    <div class="search-box">
      <input type="text" id="search-input" placeholder="搜索文章和作品..." autocomplete="off" aria-autocomplete="list" aria-controls="search-results">
      <button type="button" id="search-close" class="search-close-btn" aria-label="关闭搜索">✕</button>
    </div>
    <div id="search-results" role="region" aria-live="polite"></div>
  </div>
</div>
