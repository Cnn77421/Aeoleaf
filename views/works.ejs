<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: title,
  description: '浏览我的作品集，展示设计和开发项目',
  canonicalPath: '/works',
  twitterCard: 'summary',
  extraCss: ['/css/works-v2.css', '/css/public-pages.css']
}) %>
</head>
<body class="works-page">
  <%- include('partials/public-header') %>
  <main id="main" class="site-main site-main--no-pad">

    <!-- INTRO ========================================================= -->
    <header class="works-intro">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span class="breadcrumb-separator" aria-hidden="true">›</span>
        <span class="breadcrumb-current">作品</span>
      </nav>
      <span class="works-intro__eyebrow">Portfolio · 作品集</span>
      <h1 class="works-intro__title">Works</h1>
      <p class="works-intro__desc">
        设计与开发项目的集合。每一件都是一段相对完整的"能跑起来的想法"，顺序按时间和精选度排列。
      </p>
    </header>

    <!-- TAG FILTER ==================================================== -->
    <% if (allTags.length > 0) { %>
    <nav class="works-tagbar" aria-label="按标签筛选">
      <div class="works-tagbar__inner" role="tablist">
        <button type="button" class="tag-btn tag-v2" data-tag="all" role="tab" aria-selected="true">
          <span class="tag-btn__label">全部</span>
          <span class="tag-btn__count"><%= works.length %></span>
        </button>
        <% allTags.forEach(function (tag) { %>
        <button type="button" class="tag-btn tag-v2" data-tag="<%= tag %>" role="tab" aria-selected="false">
          <span class="tag-btn__label"><%= tag %></span>
          <span class="tag-btn__count"><%= tagCounts[tag] || 0 %></span>
        </button>
        <% }); %>
      </div>
    </nav>
    <% } %>

    <!-- BENTO GRID ==================================================== -->
    <section class="works-bento">
      <% if (works.length === 0) { %>
        <div class="works-empty-v2">
          <h3>尚未有公开作品</h3>
          <p>第一片叶还在长。先去后台 <code>/admin/works</code> 新建一件。</p>
        </div>
      <% } else { %>
      <div class="bento-grid" id="works-grid">
        <%
          var _toneRing = ['rose', 'sky', 'lime', 'violet', 'mint', 'amber'];
          works.forEach(function (work, i) {
            var isFeat   = !!work.spanFeature;
            var hasCover = !!work.cover_image;
            var mono     = (work.title || '·').trim().charAt(0).toUpperCase();
            var tone     = _toneRing[i % _toneRing.length];

            // Cell geometry: featured cell spans 8 cols, others span 4.
            var cellClass  = 'bento-cell ' + (isFeat ? 'bento-cell--8' : 'bento-cell--4') + ' bento-cell--' + tone;
            var cardClass  = 'card-v2 work-card ' + (isFeat ? 'work-card--feature-v2' : 'work-card-v2');
            // ARIA: each cover-linked card labels itself with its title.
            var workLabel = 'work-' + work.id + '-title';
        %>
        <a href="/works/<%= work.slug %>"
           class="<%= cellClass %> <%= cardClass %>"
           data-tags="<%= work.tags.join(',') %>"
           aria-labelledby="<%= workLabel %>">

          <% if (Number(work.featured) === 1 && !isFeat) { %>
          <span class="work-card__badge-v2" aria-label="精选作品">Featured</span>
          <% } %>

          <% if (hasCover) { %>
          <div class="work-card__cover-v2">
            <img src="<%= work.cover_image %>"
                 alt="<%= work.title %>"
                 loading="<%= i < 3 ? 'eager' : 'lazy' %>"
                 decoding="async"
                 width="1200" height="750">
          </div>
          <% } else { %>
          <div class="work-card__cover-v2 work-card__mono-v2" aria-hidden="true"><%= mono %></div>
          <% } %>

          <span class="card-v2__eyebrow">
            Work<% if (work.date) { %> · <%= work.date %><% } else if (work.year) { %> · <%= work.year %><% } %>
          </span>
          <h3 class="card-v2__title" id="<%= workLabel %>"><%= work.title %></h3>
          <% if (work.description) { %>
          <p class="card-v2__desc">
            <% var _wd = work.description.trim(); %>
            <%= _wd.length > (isFeat ? 160 : 90) ? _wd.slice(0, isFeat ? 160 : 90) + '…' : _wd %>
          </p>
          <% } %>

          <% if (work.tags && work.tags.length) { %>
          <div class="work-card__tags-v2" aria-hidden="true">
            <% work.tags.slice(0, 4).forEach(function (t) { %>
            <span class="tag-v2"><%= t %></span>
            <% }); %>
          </div>
          <% } %>
        </a>
        <% }); %>
      </div>
      <% } %>
    </section>

  </main>
  <%- include('partials/public-footer') %>
</body>
</html>
