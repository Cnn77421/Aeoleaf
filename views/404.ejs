<%
  const _errorCode = (typeof errorCode !== 'undefined' && errorCode) ? errorCode : 404;
  const _errorTitle = (typeof errorTitle !== 'undefined' && errorTitle)
    ? errorTitle
    : (_errorCode === 500 ? '服务器出了点状况' : '页面不存在');
  const _errorCopy = (typeof errorMessage !== 'undefined' && errorMessage)
    ? errorMessage
    : (_errorCode === 500 ? '后台出了点小状况，稍后再试或回到首页。' : '这个页面可能已被移动或删除。');
%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: _errorCode + ' — aeoleaf',
  description: _errorTitle,
  canonicalPath: '/' + _errorCode,
  noIndex: true
}) %>
<style>
.err-shell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: calc(100vh - 120px);
  max-width: 640px;
  margin: 0 auto;
  padding: var(--space-8) var(--space-6) var(--space-16);
}
.err-code {
  font-family: var(--font-display, var(--font-serif));
  font-size: clamp(6rem, 16vw, 10rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--text);
  opacity: 0.12;
  margin: 0 0 var(--space-6);
  user-select: none;
}
.err-title {
  font-family: var(--font-display, var(--font-serif));
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--text);
  margin: 0 0 var(--space-3);
}
.err-copy {
  font-size: 0.95rem;
  color: var(--text-muted);
  line-height: 1.65;
  margin: 0 0 var(--space-8);
  max-width: 40ch;
}
.err-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.err-btn-primary {
  display: inline-flex;
  align-items: center;
  padding: 0.6rem 1.2rem;
  background: var(--text);
  color: var(--bg);
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 600;
  text-decoration: none;
  transition: opacity 0.2s;
}
.err-btn-primary:hover { opacity: 0.8; }
.err-btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: 0.6rem 1.2rem;
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 500;
  text-decoration: none;
  transition: color 0.2s, border-color 0.2s;
}
.err-btn-ghost:hover { color: var(--text); border-color: var(--text-muted); }
.err-links {
  display: flex;
  gap: var(--space-5);
  margin-top: var(--space-8);
  padding-top: var(--space-6);
  border-top: 1px solid var(--border);
  list-style: none;
  padding-left: 0;
  width: 100%;
}
.err-links a {
  font-size: 0.82rem;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.2s;
}
.err-links a:hover { color: var(--accent); }
</style>
</head>
<body>
  <%- include('partials/public-header') %>
  <main id="main" class="site-main">
    <div class="err-shell">
      <p class="err-code"><%= _errorCode %></p>
      <h1 class="err-title"><%= _errorTitle %></h1>
      <p class="err-copy"><%= _errorCopy %></p>
      <div class="err-actions">
        <a href="/" class="err-btn-primary">回到首页</a>
        <a href="/?openSearch=1" class="err-btn-ghost">搜索</a>
      </div>
      <ul class="err-links">
        <li><a href="/blog">博客</a></li>
        <li><a href="/works">作品</a></li>
        <li><a href="/about">关于</a></li>
      </ul>
    </div>
  </main>
  <%- include('partials/public-footer') %>
</body>
</html>
