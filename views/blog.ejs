<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: title,
  description: (typeof description !== 'undefined' && description) ? description : '浏览所有博客文章，分享技术见解和创意思考',
  canonicalPath: '/blog', twitterCard: 'summary', extraCss: ['/css/blog-v2.css']
}) %>
</head>
<body class="journal-page">
  <%- include('partials/public-header') %>
  <main id="main" class="site-main journal-main">
    <div class="journal-shell">
      <aside class="journal-sidebar" aria-label="博客信息">
        <div class="journal-panel journal-profile">
          <img src="<%= aboutImage || '/images/logo.png' %>" alt="<%= siteTitle %>" width="82" height="82">
          <h2><%= siteTitle %></h2>
          <p class="journal-profile__role">Author · Journal</p>
          <p class="journal-profile__bio"><%= aboutSummary || siteSubtitle || '记录技术、设计与生活。' %></p>
          <dl class="journal-profile__stats">
            <div><dt>文章</dt><dd><%= statsData.postsCount %></dd></div>
            <div><dt>作品</dt><dd><%= statsData.worksCount %></dd></div>
            <div><dt>访问</dt><dd><%= statsData.totalPV %></dd></div>
          </dl>
        </div>
        <% if (allTags && allTags.length) { %>
        <nav class="journal-panel journal-tags" aria-label="标签筛选">
          <p class="journal-panel__label">标签</p>
          <a href="/blog" class="<%= !activeTag ? 'is-active' : '' %>"><span>全部文章</span><small><%= total %></small></a>
          <% allTags.forEach(function (tag) { %>
          <a href="/blog?tag=<%= encodeURIComponent(tag) %>" class="<%= tag === activeTag ? 'is-active' : '' %>"><span># <%= tag %></span></a>
          <% }); %>
        </nav>
        <% } %>
        <nav class="journal-panel journal-links" aria-label="更多入口">
          <p class="journal-panel__label">探索</p>
          <a href="/works"><span>作品集</span><b>→</b></a>
          <a href="/guestbook"><span>留言板</span><b>→</b></a>
          <a href="/rss.xml"><span>RSS 订阅</span><b>→</b></a>
        </nav>
      </aside>

      <section class="journal-feed" aria-labelledby="journal-title">
        <header class="journal-heading">
          <nav class="breadcrumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">›</span><span>博客</span></nav>
          <span class="journal-heading__eyebrow">Stories &amp; Notes</span>
          <h1 id="journal-title"><%= activeTag ? '# ' + activeTag : 'Blog' %></h1>
          <p><%= activeTag ? '正在查看该标签下的文章。' : '技术见解、创作过程，以及生活里的细小发现。' %></p>
        </header>

        <% if (!posts.length) { %>
        <div class="journal-empty"><span>🍃</span><h2>这里还没有文章</h2><p><%= activeTag ? '这个标签暂时没有匹配内容。' : '第一篇文章正在路上。' %></p><% if (activeTag) { %><a href="/blog">查看全部文章</a><% } %></div>
        <% } else { %>
        <div class="journal-list">
          <% posts.forEach(function (post, index) { var date = new Date(post.created_at).toLocaleDateString('zh-CN', { year:'numeric', month:'long', day:'numeric' }); %>
          <article class="journal-card<%= index === 0 && page === 1 ? ' journal-card--lead' : '' %>">
            <% if (post.cover_image) { %><a href="/blog/<%= post.slug %>" class="journal-card__media" tabindex="-1" aria-hidden="true"><img src="<%= post.cover_image %>" alt="" width="1200" height="675" loading="<%= index === 0 ? 'eager' : 'lazy' %>"></a><% } %>
            <div class="journal-card__body">
              <div class="journal-card__meta"><time datetime="<%= post.created_at %>"><%= date %></time><span>·</span><span>约 <%= post.readMinutes %> 分钟</span></div>
              <h2><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
              <% if (post.excerpt) { %><p><%= post.excerpt.length > 200 ? post.excerpt.slice(0, 200) + '…' : post.excerpt %></p><% } %>
              <div class="journal-card__foot">
                <div class="journal-card__tags"><% (post.tags || []).slice(0, 3).forEach(function (tag) { %><a href="/blog?tag=<%= encodeURIComponent(tag) %>">#<%= tag %></a><% }); %></div>
                <a href="/blog/<%= post.slug %>" class="journal-card__more">阅读全文 <span>→</span></a>
              </div>
            </div>
          </article>
          <% }); %>
        </div>
        <% } %>

        <% if (pagination) { var tagQ = activeTag ? ('&tag=' + encodeURIComponent(activeTag)) : ''; %>
        <nav class="journal-pagination" aria-label="分页导航">
          <% if (pagination.prev) { %><a href="/blog?page=<%= pagination.prev %><%= tagQ %>" rel="prev">←</a><% } %>
          <% pagination.parts.forEach(function (part) { if (part === 'gap') { %><span>…</span><% } else if (part === page) { %><strong aria-current="page"><%= part %></strong><% } else { %><a href="/blog?page=<%= part %><%= tagQ %>"><%= part %></a><% } }); %>
          <% if (pagination.next) { %><a href="/blog?page=<%= pagination.next %><%= tagQ %>" rel="next">→</a><% } %>
        </nav>
        <% } %>
      </section>
    </div>
  </main>
  <%- include('partials/public-footer') %>
</body>
</html>
