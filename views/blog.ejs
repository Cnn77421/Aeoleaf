<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: title,
  description: (typeof description !== 'undefined' && description) ? description : '浏览所有博客文章，分享技术见解和创意思考',
  canonicalPath: '/blog',
  twitterCard: 'summary',
  extraCss: ['/css/blog-v2.css']
}) %>
</head>
<body class="blog-v2">
  <%- include('partials/public-header') %>
  <main id="main" class="site-main">
    <div class="bl-shell">

      <!-- Intro -->
      <header class="bl-intro">
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a>
          <span class="breadcrumb-separator" aria-hidden="true">›</span>
          <span class="breadcrumb-current">博客</span>
        </nav>
        <div class="bl-intro__eyebrow"><span class="bl-intro__dot"></span>Journal</div>
        <h1 class="bl-intro__title">Blog</h1>
        <p class="bl-intro__desc">技术见解与创意思考。</p>
      </header>

      <%
        const _hasTag = typeof activeTag !== 'undefined' && activeTag;
        const _tagQ   = _hasTag ? ('&tag=' + encodeURIComponent(activeTag)) : '';
        const _allTags = typeof allTags !== 'undefined' ? allTags : [];
        const _activeTag = typeof activeTag !== 'undefined' ? activeTag : '';
      %>

      <!-- Filter bar -->
      <% if (_allTags.length > 0 || _hasTag) { %>
      <nav class="bl-filter" aria-label="标签筛选">
        <a href="/blog" class="bl-filter__btn<%= !_hasTag ? ' bl-filter__btn--active' : '' %>">全部</a>
        <% _allTags.forEach(tag => { %>
        <a href="/blog?tag=<%= encodeURIComponent(tag) %>" class="bl-filter__btn<%= tag === _activeTag ? ' bl-filter__btn--active' : '' %>">#<%= tag %></a>
        <% }); %>
        <% if (_hasTag) { %><a href="/blog" class="bl-filter__clear" aria-label="清除筛选">× 清除 #<%= activeTag %></a><% } %>
      </nav>
      <% } %>

      <% if (posts.length === 0) { %>
      <div class="bl-empty">
        <p class="bl-empty__title"><% if (_hasTag) { %>没有找到相关文章<% } else { %>这里还没有文章<% } %></p>
        <p class="bl-empty__desc">
          <% if (_hasTag) { %>暂无带 <strong>#<%= activeTag %></strong> 标签的文章。<a href="/blog">查看全部</a>。<% } else { %>第一篇文章正在路上。<% } %>
        </p>
      </div>
      <% } else { %>

      <%
        const _featured = posts[0];
        const _rest     = posts.slice(1);
        const _fDate    = new Date(_featured.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
        const _fInitial = (_featured.title && String(_featured.title).trim()) ? String(_featured.title).trim().charAt(0) : '?';
      %>

      <!-- Featured post (Clerk magazine hero) -->
      <a href="/blog/<%= _featured.slug %>" class="bl-featured">
        <div class="bl-featured__media">
          <% if (_featured.cover_image) { %>
          <img src="<%= _featured.cover_image %>" alt="<%= _featured.title %>" class="bl-featured__img" loading="eager">
          <% } else { %>
          <div class="bl-featured__mono"><%= _fInitial %></div>
          <% } %>
        </div>
        <div class="bl-featured__body">
          <div class="bl-featured__eyebrow">
            <span style="width:5px;height:5px;border-radius:50%;background:currentColor;display:inline-block;"></span>
            最新文章
            <% if (_featured.tags && _featured.tags.length > 0) { %>
            <span class="bl-featured__tag">#<%= _featured.tags[0] %></span>
            <% } %>
          </div>
          <h2 class="bl-featured__title"><%= _featured.title %></h2>
          <% if (_featured.excerpt) { %><p class="bl-featured__excerpt"><%= _featured.excerpt %></p><% } %>
          <div class="bl-featured__meta">
            <time datetime="<%= _featured.created_at %>"><%= _fDate %></time>
            <% if (_featured.readMinutes) { %><span>·</span><span>约 <%= _featured.readMinutes %> 分钟</span><% } %>
          </div>
        </div>
      </a>

      <!-- Post list (Vercel rhythm) -->
      <% if (_rest.length > 0) { %>
      <div class="bl-list">
        <% _rest.forEach(post => { %>
        <%
          const _d = new Date(post.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
          const _init = (post.title && String(post.title).trim()) ? String(post.title).trim().charAt(0) : '?';
        %>
        <a href="/blog/<%= post.slug %>" class="bl-item">
          <div class="bl-item__body">
            <div class="bl-item__meta">
              <time datetime="<%= post.created_at %>"><%= _d %></time>
              <% if (post.readMinutes) { %><span class="bl-item__dot">·</span><span>约 <%= post.readMinutes %> 分钟</span><% } %>
            </div>
            <h2 class="bl-item__title"><%= post.title %></h2>
            <% if (post.excerpt) { %><p class="bl-item__excerpt"><%= post.excerpt %></p><% } %>
            <% if (post.tags && post.tags.length > 0) { %>
            <div class="bl-item__tags">
              <% post.tags.forEach(tag => { %><span class="bl-item__tag">#<%= tag %></span><% }); %>
            </div>
            <% } %>
          </div>
          <div class="bl-item__thumb">
            <% if (post.cover_image) { %>
            <img src="<%= post.cover_image %>" alt="" loading="lazy">
            <% } else { %>
            <div class="bl-item__thumb-mono"><%= _init %></div>
            <% } %>
          </div>
        </a>
        <% }); %>
      </div>
      <% } %>

      <% } %>

      <!-- Pagination -->
      <% if (typeof pagination !== 'undefined' && pagination) { %>
      <nav class="bl-pagination" aria-label="分页导航">
        <% if (pagination.prev) { %><a class="bl-pagination__btn" href="/blog?page=<%= pagination.prev %><%= _tagQ %>" rel="prev">‹</a><% } %>
        <% pagination.parts.forEach(function(part) { %>
          <% if (part === 'gap') { %><span class="bl-pagination__gap">…</span>
          <% } else if (part === page) { %><span class="bl-pagination__btn bl-pagination__btn--active" aria-current="page"><%= part %></span>
          <% } else { %><a class="bl-pagination__btn" href="/blog?page=<%= part %><%= _tagQ %>"><%= part %></a><% } %>
        <% }); %>
        <% if (pagination.next) { %><a class="bl-pagination__btn" href="/blog?page=<%= pagination.next %><%= _tagQ %>" rel="next">›</a><% } %>
        <span class="bl-pagination__summary"><%= page %> / <%= totalPages %></span>
      </nav>
      <% } %>

    </div>
  </main>
  <%- include('partials/public-footer') %>
</body>
</html>
