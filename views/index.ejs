<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: title + ' — ' + subtitle,
  description: 'Aeoleaf 风叶：' + subtitle + ' — 个人博客与作品集，记录设计与技术笔记。',
  canonicalPath: '/',
  ogType: 'website',
  twitterCard: 'summary_large_image',
  extraCss: ['/css/home.css']
}) %>
  <% if (featuredPost && featuredPost.cover_image) { %>
  <link rel="preload" as="image" href="<%= featuredPost.cover_image %>" fetchpriority="high">
  <% } %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "<%= title %>",
    "url": "<%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %>/",
    "description": "Aeoleaf 风叶：个人博客与作品集，记录设计与技术笔记。",
    "author": { "@type": "Person", "name": "aeoleaf" }
  }
  </script>
</head>
<body class="home-page">
  <%- include('partials/public-header') %>
  <main id="main" class="site-main site-main--no-pad">

    <!-- HERO ========================================================== -->
    <section class="home-hero">
      <div class="home-hero__inner">
        <span class="home-hero__eyebrow">写作 · 作品 · 偶尔实现</span>
        <%
          // Render the wordmark as a single, uniform display title. We
          // intentionally drop the italic gradient accent so the brand
          // reads as one shape instead of two voices.
          var _wordmark = (typeof heroTitleMain !== 'undefined' && heroTitleMain)
            ? heroTitleMain
            : title;
          if (typeof heroTitleAccent !== 'undefined' && heroTitleAccent) {
            _wordmark = _wordmark + ' ' + heroTitleAccent;
          }
        %>
        <h1 class="home-hero__title"><%= _wordmark %></h1>
        <p class="home-hero__sub">
          <%= subtitle %> · 个人博客与作品集。记录设计、工程与写作中值得留下的那一点东西，不做惊天动地，只做能看得见的生长。
        </p>
        <div class="home-hero__cta">
          <a href="/works" class="btn-v2 btn-v2--primary btn-v2--lg">查看作品</a>
          <a href="/blog" class="btn-v2 btn-v2--ghost btn-v2--lg">阅读博客</a>
        </div>
      </div>
    </section>

    <!-- BENTO ========================================================= -->
    <div class="home-bento">
      <div class="bento-grid">

        <!-- Featured post (8 wide × 2 tall) =========================== -->
        <% if (featuredPost) { %>
        <a href="/blog/<%= featuredPost.slug %>"
           class="bento-cell bento-cell--8 bento-cell--tall bento-cell--violet card-v2 home-featured-post">
          <% if (featuredPost.cover_image) { %>
          <div class="home-featured-post__media">
            <img src="<%= featuredPost.cover_image %>" alt="" loading="eager" decoding="async" width="1200" height="720">
          </div>
          <% } %>
          <span class="card-v2__eyebrow">● Featured · 精选文章</span>
          <h2 class="card-v2__title"><%= featuredPost.title %></h2>
          <% var _fpExcerpt = (featuredPost.excerpt || '').trim(); %>
          <% if (_fpExcerpt) { %>
          <p class="card-v2__desc"><%= _fpExcerpt.length > 140 ? _fpExcerpt.slice(0, 140) + '…' : _fpExcerpt %></p>
          <% } %>
          <div class="card-v2__meta">
            <time><%= new Date(featuredPost.created_at).toLocaleDateString('zh-CN') %></time>
            <% if (featuredPost.tags && featuredPost.tags.length) { %>
            <span>·</span><span><%= featuredPost.tags[0] %></span>
            <% } %>
          </div>
        </a>
        <% } else { %>
        <div class="bento-cell bento-cell--8 bento-cell--tall bento-cell--violet card-v2 card-v2--feature home-featured-post home-featured-post--empty">
          <span class="card-v2__eyebrow">Welcome</span>
          <h2 class="card-v2__title">新的一叶，还没落下</h2>
          <p class="card-v2__desc">首页精选会在发布第一篇带封面的文章后自动出现。</p>
        </div>
        <% } %>

        <!-- About summary (4 wide × 1 tall) =========================== -->
        <div class="bento-cell bento-cell--4 card-v2">
          <span class="card-v2__eyebrow">About · 关于</span>
          <h3 class="card-v2__title">嗨，我在这里写东西</h3>
          <p class="card-v2__desc">
            <% if (typeof aboutSummary !== 'undefined' && aboutSummary) { %>
              <%= aboutSummary.length > 180 ? aboutSummary.slice(0, 180) + '…' : aboutSummary %>
            <% } else { %>
              这里会显示个人简介摘要；可在后台 Settings 里编辑。
            <% } %>
          </p>
          <a href="/about" class="card-v2__cta">了解更多</a>
        </div>

        <!-- Stats (4 wide × 1 tall) =================================== -->
        <div class="bento-cell bento-cell--4 bento-cell--mint card-v2 card-v2--solid">
          <span class="card-v2__eyebrow">Stats · 站点</span>
          <dl class="home-stats" aria-label="站点概览">
            <div>
              <dt>文章</dt>
              <dd><span class="hp-stats__number" data-target="<%= statsData.postsCount %>">0</span></dd>
            </div>
            <div>
              <dt>作品</dt>
              <dd><span class="hp-stats__number" data-target="<%= statsData.worksCount %>">0</span></dd>
            </div>
            <div>
              <dt>访问</dt>
              <dd><span class="hp-stats__number" data-target="<%= statsData.totalPV %>">0</span></dd>
            </div>
          </dl>
        </div>

        <!-- Featured works (three 4-wide cards) ======================= -->
        <%
          var _toneRing = ['rose', 'sky', 'lime'];
          var _picks = (featuredWorks || []).slice(0, 3);
          _picks.forEach(function (work, i) {
            var tone = _toneRing[i % _toneRing.length];
            var mono = (work.title || '·').trim().charAt(0).toUpperCase();
        %>
        <a href="/works/<%= work.slug %>"
           class="bento-cell bento-cell--4 bento-cell--<%= tone %> card-v2">
          <% if (work.cover_image) { %>
          <div class="home-work__cover">
            <img src="<%= work.cover_image %>" alt="<%= work.title %>" loading="lazy" decoding="async">
          </div>
          <% } else { %>
          <div class="home-work__cover home-work__mono" aria-hidden="true"><%= mono %></div>
          <% } %>
          <span class="card-v2__eyebrow">
            Work<% if (work.year) { %> · <%= work.year %><% } %>
            <% if (work.tags && work.tags.length) { %> · <%= work.tags[0] %><% } %>
          </span>
          <h3 class="card-v2__title"><%= work.title %></h3>
          <% if (work.description) { %>
          <p class="card-v2__desc"><%= work.description.length > 80 ? work.description.slice(0, 80) + '…' : work.description %></p>
          <% } %>
          <span class="card-v2__cta">查看项目</span>
        </a>
        <% }); %>

        <!-- Recent posts list (8 wide × 2 tall) ====================== -->
        <% if (recentPosts.length > 0) { %>
        <div class="bento-cell bento-cell--8 bento-cell--tall card-v2">
          <div class="home-list__head">
            <div>
              <span class="card-v2__eyebrow">Recent · 最近文章</span>
              <h3 class="card-v2__title" style="font-size: clamp(20px, 2vw, 26px); margin-top: 6px;">近期更新</h3>
            </div>
            <a href="/blog" class="home-list__more">全部文章 →</a>
          </div>
          <ul class="home-list">
            <% recentPosts.slice(0, 5).forEach(function (post) { %>
            <li class="home-list__item">
              <a href="/blog/<%= post.slug %>" class="home-list__link">
                <time class="home-list__date"><%= new Date(post.created_at).toLocaleDateString('zh-CN') %></time>
                <span class="home-list__title"><%= post.title %></span>
                <% if (post.tags && post.tags.length) { %>
                <span class="tag-v2"><%= post.tags[0] %></span>
                <% } else { %>
                <span></span>
                <% } %>
              </a>
            </li>
            <% }); %>
          </ul>
        </div>
        <% } %>

        <!-- Contact (4 wide × 2 tall) ================================ -->
        <div class="bento-cell bento-cell--4 bento-cell--tall bento-cell--amber card-v2 card-v2--feature">
          <span class="card-v2__eyebrow">Contact · 一起聊聊</span>
          <h3 class="card-v2__title">合作或闲聊，都欢迎</h3>
          <p class="card-v2__desc">不定期回复。想交换设计、写作、工程上的一点想法都行。</p>
          <%
            // Heuristic: map a few common labels to the icon sprite so the
            // list stays visually coherent. Anything unmatched falls back
            // to the generic external-link look (no icon block rendered).
            function _iconIdFor(label) {
              var s = String(label || '').toLowerCase();
              if (/github/.test(s)) return 'icon-github';
              if (/mail|email|邮箱/.test(s)) return 'icon-mail';
              if (/rss|订阅/.test(s)) return 'icon-rss';
              return null;
            }
            var _email = (typeof contactEmail !== 'undefined') ? contactEmail : '';
            var _qq = (typeof contactQq !== 'undefined') ? contactQq : '';
            var _links = Array.isArray(typeof socialLinks !== 'undefined' ? socialLinks : null) ? socialLinks : [];
            var _hasAny = _email || _qq || _links.length;
          %>
          <ul class="home-contact">
            <% if (_email) { %>
            <li>
              <a href="mailto:<%= _email %>">
                <svg width="18" height="18" aria-hidden="true"><use href="#icon-mail"/></svg>
                <span class="home-contact__label">Email</span>
                <span class="home-contact__val"><%= _email %></span>
              </a>
            </li>
            <% } %>
            <% _links.forEach(function (lnk) {
                 var iconId = _iconIdFor(lnk.label);
                 var isExternal = /^https?:\/\//i.test(lnk.url);
            %>
            <li>
              <a href="<%= lnk.url %>"<% if (isExternal) { %> target="_blank" rel="noopener"<% } %>>
                <% if (iconId) { %>
                <svg width="18" height="18" aria-hidden="true"><use href="#<%= iconId %>"/></svg>
                <% } else { %>
                <span class="home-contact__bullet" aria-hidden="true">→</span>
                <% } %>
                <span class="home-contact__label"><%= lnk.label %></span>
              </a>
            </li>
            <% }); %>
            <% if (_qq) { %>
            <li>
              <a href="#" onclick="return false" aria-label="QQ 号码">
                <span class="home-contact__bullet" aria-hidden="true">QQ</span>
                <span class="home-contact__label">QQ</span>
                <span class="home-contact__val"><%= _qq %></span>
              </a>
            </li>
            <% } %>
            <li>
              <a href="/rss.xml">
                <svg width="18" height="18" aria-hidden="true"><use href="#icon-rss"/></svg>
                <span class="home-contact__label">RSS</span>
                <span class="home-contact__val">订阅更新</span>
              </a>
            </li>
            <% if (!_hasAny) { %>
            <li class="home-contact__hint">
              <span class="home-contact__label">后台 Settings 里填写联系方式即可显示在这里。</span>
            </li>
            <% } %>
          </ul>
        </div>

      </div>
    </div>

  </main>
  <%- include('partials/public-footer') %>
</body>
</html>
