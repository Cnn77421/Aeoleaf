<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: title + ' — ' + subtitle,
  description: 'Aeoleaf 风叶：' + subtitle + ' — 个人博客与作品集，记录设计与技术笔记。',
  canonicalPath: '/', ogType: 'website', twitterCard: 'summary_large_image', extraCss: ['/css/home.css']
}) %>
<% if (heroImage) { %><link rel="preload" as="image" href="<%= heroImage %>" fetchpriority="high"><% } %>
</head>
<body class="home-page home-v2">
<%- include('partials/public-header') %>
<main id="main" class="site-main home-shell">
  <section class="home-intro<%= heroImage ? ' home-intro--image' : '' %>" aria-labelledby="home-title">
    <div class="home-intro__copy">
      <p class="home-eyebrow">AEOLEAF / 写作 · 设计 · 生活</p>
      <h1 id="home-title"><%= title %></h1>
      <p class="home-intro__subtitle"><%= subtitle %></p>
      <p class="home-intro__description"><%= aboutSummary || '记录设计与技术笔记，整理做过的作品，也留下一处与来访者交流的空间。' %></p>
      <div class="home-actions"><a class="btn-v2 btn-v2--primary" href="/blog">阅读文章 <span aria-hidden="true">↗</span></a><a class="btn-v2" href="/works">浏览作品</a></div>
    </div>
    <% if (heroImage) { %>
    <picture class="home-intro__image">
      <% if (heroImageMobile) { %><source media="(max-width: 767.98px)" srcset="<%= heroImageMobile %>"><% } %>
      <img src="<%= heroImage %>" alt="" width="960" height="640" fetchpriority="high" decoding="async" style="--hero-position-desktop:<%= heroPosition %>;--hero-position-mobile:<%= heroPositionMobile %>">
    </picture>
    <% } %>
  </section>
  <div class="home-content">
    <div class="home-feed">
      <section aria-labelledby="home-writing">
        <header class="home-section-heading"><div><p class="home-eyebrow">JOURNAL</p><h2 id="home-writing">最新文章</h2></div><a href="/blog">全部文章 <span aria-hidden="true">→</span></a></header>
        <% if (recentPosts.length) { %><div class="home-posts"><% recentPosts.forEach(function (item) { %>
          <%- include('partials/content-card', { item: item, href: '/blog/' + item.slug, kind: '文章' }) %>
        <% }); %></div><% } else { %><div class="empty-state"><h3>文字正在酝酿</h3><p>新的文章会出现在这里，欢迎以后再来。</p></div><% } %>
      </section>
      <section aria-labelledby="home-works">
        <header class="home-section-heading"><div><p class="home-eyebrow">SELECTED WORK</p><h2 id="home-works">精选作品</h2></div><a href="/works">全部作品 <span aria-hidden="true">→</span></a></header>
        <% if (featuredWorks.length) { %><div class="home-works"><% featuredWorks.forEach(function (item) { %>
          <%- include('partials/content-card', { item: item, href: '/works/' + item.slug, kind: '作品' }) %>
        <% }); %></div><% } else { %><div class="empty-state"><h3>作品持续整理中</h3><p>更多探索与实践，敬请期待。</p></div><% } %>
      </section>
    </div>
    <aside class="home-profile" aria-label="个人信息">
      <% if (aboutImage) { %><img class="home-profile__avatar" src="<%= aboutImage %>" alt="" width="64" height="64" loading="lazy"><% } %>
      <p class="home-eyebrow">ABOUT</p><h2><%= title %></h2>
      <p>这里收集文字、作品，以及生活里的细小发现。</p>
      <dl class="home-stats"><div><dt>文章</dt><dd><%= statsData.postsCount %></dd></div><div><dt>作品</dt><dd><%= statsData.worksCount %></dd></div><div><dt>访问</dt><dd><%= statsData.totalPV %></dd></div></dl>
      <nav class="home-profile__links" aria-label="了解与联系"><a href="/about">更多关于我 <span>↗</span></a><a href="/guestbook">留下一句问候 <span>↗</span></a><a href="/rss.xml">订阅 RSS <span>↗</span></a>
        <% if (contactEmail) { %><a href="mailto:<%= contactEmail %>">发送邮件 <span>↗</span></a><% } %>
        <% socialLinks.forEach(function (link) { %><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %> <span>↗</span></a><% }); %>
      </nav>
      <% if (contactQq) { %><p class="home-profile__qq">QQ · <%= contactQq %></p><% } %>
    </aside>
  </div>
</main>
<%- include('partials/public-footer', { contactEmail: contactEmail, contactQq: contactQq, socialLinks: socialLinks }) %>
</body>
</html>
