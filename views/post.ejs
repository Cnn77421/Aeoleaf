<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: post.title + ' — aeoleaf',
  description: post.excerpt || post.title,
  canonicalPath: '/blog/' + post.slug,
  ogType: 'article',
  ogImagePath: post.cover_image || '/images/logo.png',
  twitterCard: 'summary_large_image',
  extraCss: ['/css/blog-v2.css']
}) %>
  <meta property="article:published_time" content="<%= post.created_at %>">
  <% post.tags.forEach(tag => { %>
  <meta property="article:tag" content="<%= tag %>">
  <% }); %>
  <% if (post.cover_image) { %>
  <link rel="preload" as="image" href="<%= post.cover_image %>" fetchpriority="high">
  <% } %>
  <%
    var _baseUrl = typeof baseUrl !== 'undefined' && baseUrl ? baseUrl : 'http://localhost:3000';
    var _articleJsonLd = {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.excerpt || post.title,
      datePublished: post.created_at,
      dateModified: post.updated_at || post.created_at,
      url: _baseUrl + '/blog/' + post.slug,
      mainEntityOfPage: _baseUrl + '/blog/' + post.slug,
      keywords: (post.tags || []).join(', '),
      author: { '@type': 'Person', name: 'aeoleaf' },
      publisher: {
        '@type': 'Organization',
        name: 'aeoleaf 风叶',
        logo: { '@type': 'ImageObject', url: _baseUrl + '/images/logo.svg' }
      }
    };
    if (post.cover_image) {
      _articleJsonLd.image = (post.cover_image.indexOf('http') === 0)
        ? post.cover_image
        : _baseUrl + post.cover_image;
    }
  %>
  <script type="application/ld+json"><%- JSON.stringify(_articleJsonLd) %></script>
</head>
<body class="journal-post-page">
  <div class="reading-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="reading-progress__bar"></span></div>
  <%- include('partials/public-header') %>
  <main id="main" class="site-main journal-main">
    <div class="journal-post-shell">
      <article class="post-detail journal-article" id="article-top" data-post-article>
        <div class="journal-article__hero<%= post.cover_image ? '' : ' journal-article__hero--placeholder' %>">
          <% if (post.cover_image) { %><img src="<%= post.cover_image %>" alt="" width="1400" height="788" fetchpriority="high"><% } %>
          <div class="journal-article__hero-shade" aria-hidden="true"></div>
          <div class="journal-article__hero-copy">
            <h1><%= post.title %></h1>
          </div>
        </div>
        <div class="journal-article__byline">
          <img src="<%= aboutImage || '/images/logo.png' %>" alt="<%= siteTitle %>" width="52" height="52">
          <div class="journal-article__author"><strong><%= siteTitle %></strong><small>Author</small></div>
          <div class="journal-article__byline-meta">
            <time datetime="<%= post.created_at %>"><%= new Date(post.created_at).toLocaleDateString('zh-CN', {year:'numeric',month:'long',day:'numeric'}) %></time>
            <span>·</span><span><%= readMinutes %> 分钟</span><span>·</span><span><%= post.views || 0 %> 次阅读</span>
          </div>
          <% if (post.tags.length) { %><div class="journal-article__tags"><% post.tags.forEach(function (tag) { %><a href="/blog?tag=<%= encodeURIComponent(tag) %>">#<%= tag %></a><% }); %></div><% } %>
        </div>
        <div class="journal-article__inner">
          <% if (post.excerpt) { %><p class="journal-article__lead"><%= post.excerpt %></p><% } %>
          <div class="prose journal-prose"><%- post.html %></div>
          <footer class="journal-article__footer"><a href="/blog">← 返回文章列表</a><span>感谢阅读这一叶。</span></footer>
        </div>
      </article>

      <aside class="journal-post-aside" aria-label="文章辅助信息">
        <% if (tocVisible) { %>
        <div class="post-toc journal-panel" aria-label="本页目录">
          <details class="post-toc__details" open>
            <summary class="post-toc__summary"><span>目录</span></summary>
            <h2 class="post-toc__title"><a href="#article-top"><%= post.title %></a></h2>
            <ol class="post-toc__list">
              <% toc.forEach(function (h) { %><li class="post-toc__item post-toc__item--h<%= h.level %>"><a class="post-toc__link" href="#<%= h.id %>" data-toc-target="<%= h.id %>"><%= h.text %></a></li><% }); %>
            </ol>
          </details>
        </div>
        <% } %>
        <nav class="journal-panel journal-links" aria-label="更多入口"><p class="journal-panel__label">继续探索</p><a href="/works"><span>作品集</span><b>→</b></a><a href="/guestbook"><span>留言板</span><b>→</b></a></nav>
      </aside>
    </div>
  </main>
  <%- include('partials/public-footer') %>
  <script>
  (function () {
    var bar = document.querySelector('.reading-progress');
    var fill = bar && bar.querySelector('.reading-progress__bar');
    var article = document.querySelector('[data-post-article]');

    function fallbackCopy(text) {
      var input = document.createElement('textarea');
      input.value = text;
      input.setAttribute('readonly', '');
      input.style.position = 'fixed';
      input.style.opacity = '0';
      document.body.appendChild(input);
      input.select();
      var copied = false;
      try { copied = document.execCommand('copy'); } catch (_e) { copied = false; }
      input.remove();
      return Promise.resolve(copied);
    }

    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallbackCopy(text); });
      }
      return fallbackCopy(text);
    }

    Array.prototype.slice.call(document.querySelectorAll('[data-copy-code]')).forEach(function (button) {
      button.addEventListener('click', function () {
        var frame = button.closest('.code-frame');
        var code = frame && frame.querySelector('pre code');
        if (!code) return;
        var rows = Array.prototype.slice.call(code.querySelectorAll('.code-line__content'));
        var source = rows.length ? rows.map(function (row) { return row.textContent === '\u200b' ? '' : row.textContent; }).join('\n') : (code.textContent || '');
        copyText(source).then(function (copied) {
          if (!copied) return;
          button.textContent = '已复制';
          button.classList.add('is-copied');
          window.setTimeout(function () {
            button.textContent = '复制';
            button.classList.remove('is-copied');
          }, 1600);
        });
      });
    });

    if (!bar || !fill || !article) return;
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var tocLinks = Array.prototype.slice.call(document.querySelectorAll('.post-toc__link[data-toc-target]'));
    var targets = tocLinks.map(function (a) {
      return { link: a, el: document.getElementById(a.getAttribute('data-toc-target')) };
    }).filter(function (t) { return t.el; });
    var activeLink = null;
    function setActive(link) {
      if (activeLink === link) return;
      if (activeLink) { activeLink.classList.remove('is-active'); activeLink.removeAttribute('aria-current'); }
      activeLink = link;
      if (link) { link.classList.add('is-active'); link.setAttribute('aria-current', 'location'); }
    }
    function syncToc() {
      if (!targets.length) return;
      var anchor = (window.innerHeight || document.documentElement.clientHeight) * 0.25;
      var current = targets[0];
      for (var i = 0; i < targets.length; i++) {
        var top = targets[i].el.getBoundingClientRect().top;
        if (top - anchor <= 0) current = targets[i];
        else break;
      }
      setActive(current.link);
    }
    var ticking = false;
    function update() {
      ticking = false;
      var rect = article.getBoundingClientRect();
      var viewH = window.innerHeight || document.documentElement.clientHeight;
      var start = rect.top + window.pageYOffset;
      var total = Math.max(1, rect.height - viewH);
      var scrolled = window.pageYOffset - start + Math.min(viewH * 0.2, 120);
      var pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
      fill.style.width = pct.toFixed(2) + '%';
      bar.setAttribute('aria-valuenow', String(Math.round(pct)));
      syncToc();
    }
    function onScroll() {
      if (ticking) return;
      if (reduced) { update(); return; }
      ticking = true;
      requestAnimationFrame(update);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
  </script>
</body>
</html>
