<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <%- include('partials/styles') %>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'visitors' }) %>

  <main class="admin-main">
    <div class="breadcrumb">
      <a href="/admin/visitors">访客列表</a>
      <span class="sep">/</span>
      <span>详情 #<%= visitor.id %></span>
    </div>

    <div class="admin-header">
      <h1>访客详情 #<%= visitor.id %></h1>
      <a href="/admin/visitors" class="btn-link">返回列表</a>
    </div>

    <%
      function fmtTime(ms) {
        if (!ms) return '—';
        var d = new Date(Number(ms));
        if (isNaN(d.getTime())) return String(ms);
        var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
        return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate())
             + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      }
      function fmtStay(ms) {
        var n = Number(ms);
        if (!n || n <= 0) return '—';
        if (n < 1000) return n + 'ms';
        return (n / 1000).toFixed(1) + 's';
      }
      var stayMs = Number(visitor.stay_duration_ms || 0);
      var scrollDepth = Number(visitor.max_scroll_depth || 0);
      var engagementState = visitor.is_bot ? 'bot' : (stayMs >= 30000 || scrollDepth >= 75 ? 'engaged' : (stayMs > 0 && stayMs < 5000 ? 'quick' : 'normal'));
      var engagementLabel = engagementState === 'bot' ? '机器人访问' : (engagementState === 'engaged' ? '高参与访问' : (engagementState === 'quick' ? '快速离开' : '普通访问'));
      var scopedSessionDuration = (pathRows || []).reduce(function(total, row) { return total + Number(row.stay_duration_ms || 0); }, 0);
    %>

    <section class="visitor-detail-summary" aria-label="访问摘要">
      <article><span>访问页面</span><strong><%= visitor.path || '/' %></strong><small><%= fmtTime(visitor.tracked_at) %></small></article>
      <article><span>停留时间</span><strong><%= fmtStay(stayMs) %></strong><small>进入至离开</small></article>
      <article><span>滚动深度</span><strong><%= scrollDepth ? scrollDepth.toFixed(1) + '%' : '—' %></strong><small>页面最大阅读位置</small></article>
      <article><span>会话规模</span><strong><%= (pathRows || []).length || 1 %> 页</strong><small><%= session ? fmtStay(scopedSessionDuration) : '单页访问' %></small></article>
      <article class="visitor-detail-status"><span>参与状态</span><strong class="visitor-quality visitor-quality--<%= engagementState %>"><%= engagementLabel %></strong><small><%= visitor.is_bot ? '自动识别' : '根据停留与滚动判断' %></small></article>
    </section>

    <div class="detail-sections visitor-detail-sections">
      <div class="recent-section visitor-detail-card">
        <h2>请求信息</h2>
        <div class="detail-grid">
          <div><strong>访问时间:</strong> <%= fmtTime(visitor.tracked_at) %></div>
          <div><strong>IP:</strong> <%= visitor.ip || '—' %> <% if (visitor.ip) { %><button class="btn-link btn-danger-text" type="button" data-blacklist-add data-ip="<%= visitor.ip || '' %>">拉黑</button><% } %></div>
          <div><strong>完整 URL:</strong> <span style="word-break:break-all"><%= visitor.full_url || '—' %></span></div>
          <div><strong>路径:</strong> <%= visitor.path || '/' %></div>
          <div><strong>来源页面:</strong> <span style="word-break:break-all"><%= visitor.referer || '—' %></span></div>
          <div><strong>查询参数:</strong> <%= visitor.query_string || '—' %></div>
        </div>
      </div>

      <div class="recent-section visitor-detail-card">
        <h2>设备与环境</h2>
        <div class="detail-grid">
          <div><strong>设备类型:</strong> <%= visitor.device_type || '—' %></div>
          <div><strong>操作系统:</strong> <%= visitor.os_name %> <%= visitor.os_version %></div>
          <div><strong>浏览器:</strong> <%= visitor.browser_name %> <%= visitor.browser_version %></div>
          <div><strong>屏幕分辨率:</strong> <%= visitor.screen_resolution || '—' %></div>
          <div><strong>视口大小:</strong> <%= visitor.viewport_size || '—' %></div>
          <div><strong>像素比:</strong> <%= visitor.device_pixel_ratio ? Number(visitor.device_pixel_ratio).toFixed(2) : '—' %></div>
          <div><strong>语言:</strong> <%= visitor.language || '—' %></div>
          <div><strong>时区:</strong> <%= visitor.timezone || '—' %></div>
          <div><strong>Cookie:</strong> <%= visitor.cookie_enabled ? '是' : '否' %></div>
          <div><strong>无痕模式:</strong> <%= visitor.incognito ? '是' : '否' %></div>
          <div><strong>CPU 核数:</strong> <%= visitor.cpu_cores || '—' %></div>
          <div><strong>设备内存:</strong> <%= visitor.device_memory ? visitor.device_memory + ' GB' : '—' %></div>
        </div>
      </div>

      <div class="recent-section visitor-detail-card">
        <h2>地域与网络</h2>
        <div class="detail-grid">
          <div><strong>地域:</strong> <%= [visitor.country, visitor.province, visitor.city].filter(Boolean).join(' / ') || '—' %></div>
          <div><strong>运营商:</strong> <%= visitor.isp || '—' %></div>
          <div><strong>网络类型:</strong> <%= (visitor.network_type && String(visitor.network_type).trim()) ? visitor.network_type : '—' %></div>
          <div><strong>下行带宽:</strong> <%= visitor.downlink ? visitor.downlink + ' Mbps' : '—' %></div>
          <div><strong>延迟:</strong> <%= visitor.rtt ? visitor.rtt + ' ms' : '—' %></div>
        </div>
      </div>

      <div class="recent-section visitor-detail-card">
        <h2>行为数据</h2>
        <div class="detail-grid">
          <div><strong>进入时间:</strong> <%= fmtTime(visitor.page_enter_at) %></div>
          <div><strong>离开时间:</strong> <%= fmtTime(visitor.page_leave_at) %></div>
          <div><strong>停留时长:</strong> <%= fmtStay(visitor.stay_duration_ms) %></div>
          <div><strong>最大滚动:</strong> <%= visitor.max_scroll_depth ? Number(visitor.max_scroll_depth).toFixed(1) + '%' : '—' %></div>
          <div><strong>机器人:</strong> <%= visitor.is_bot ? '是' : '否' %></div>
        </div>
      </div>

      <% if (visitor.utm_source || visitor.utm_medium || visitor.utm_campaign || visitor.search_keyword) { %>
      <div class="recent-section visitor-detail-card">
        <h2>来源与营销</h2>
        <div class="detail-grid">
          <div><strong>UTM 来源:</strong> <%= visitor.utm_source || '—' %></div>
          <div><strong>UTM 媒介:</strong> <%= visitor.utm_medium || '—' %></div>
          <div><strong>UTM 活动:</strong> <%= visitor.utm_campaign || '—' %></div>
          <div><strong>搜索关键词:</strong> <%= visitor.search_keyword || '—' %></div>
        </div>
      </div>
      <% } %>

      <details class="recent-section visitor-detail-card visitor-technical-card">
        <summary><span><strong>诊断标识</strong><small>指纹、请求及会话标识</small></span><i class="ti ti-chevron-down"></i></summary>
        <div class="detail-grid">
          <div><strong>指纹 ID:</strong> <span style="word-break:break-all"><%= visitor.fingerprint_id %></span><button type="button" class="visitor-copy" data-copy-value="<%= visitor.fingerprint_id || '' %>">复制</button></div>
          <div><strong>请求 ID:</strong> <span style="word-break:break-all"><%= visitor.request_id || '—' %></span><button type="button" class="visitor-copy" data-copy-value="<%= visitor.request_id || '' %>">复制</button></div>
          <div><strong>页面视图 ID:</strong> <span style="word-break:break-all"><%= visitor.page_view_id || '—' %></span><button type="button" class="visitor-copy" data-copy-value="<%= visitor.page_view_id || '' %>">复制</button></div>
          <div><strong>会话 ID:</strong> <%= visitor.session_id || '—' %><button type="button" class="visitor-copy" data-copy-value="<%= visitor.session_id || '' %>">复制</button></div>
        </div>
      </details>

      <% if (session) { %>
      <div class="recent-section visitor-detail-card">
        <h2>会话信息</h2>
        <div class="detail-grid">
          <div><strong>会话编号:</strong> #<%= session.id %></div>
          <div><strong>开始时间:</strong> <%= fmtTime(session.start_time) %></div>
          <div><strong>结束时间:</strong> <%= fmtTime(session.end_time) %></div>
          <div><strong>页面数:</strong> <%= session.page_count %></div>
          <div><strong>总时长:</strong> <%= fmtStay(session.total_duration) %></div>
        </div>
      </div>
      <% } %>

      <div class="recent-section visitor-path-card">
        <header><div><h2>会话路径</h2><p>按时间顺序还原本次访问旅程</p></div><span class="visitors-filter-count"><%= (pathRows || []).length %> 个页面</span></header>
        <% if (!pathRows || pathRows.length === 0) { %><p class="empty-state">暂无访问路径</p><% } %>
        <ol class="visitor-path-timeline">
          <% (pathRows || []).forEach(function(row, index) { %>
          <li>
            <span class="visitor-path-index"><%= index + 1 %></span>
            <div class="visitor-path-main"><strong><%= row.path || '/' %></strong><small><%= fmtTime(row.tracked_at) %></small><span title="<%= row.full_url || '' %>"><%= row.full_url || row.path || '/' %></span></div>
            <div class="visitor-path-metrics"><span><i class="ti ti-clock"></i><%= fmtStay(row.stay_duration_ms) %></span><span><i class="ti ti-arrow-down"></i><%= row.max_scroll_depth ? Number(row.max_scroll_depth).toFixed(1) + '%' : '—' %></span></div>
          </li>
          <% }) %>
        </ol>
      </div>
    </div>
  </main>
  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
