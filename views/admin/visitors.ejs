<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <%- include('partials/styles') %>
  <script src="<%= asset('/vendor/chartjs/chart.umd.min.js') %>"></script>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'visitors' }) %>

  <main class="admin-main admin-main--wide">
    <div class="dashboard-container">
      <div class="dashboard-welcome">
        <h1>访客分析</h1>
        <p class="dashboard-subtitle">实时访问统计、轨迹和设备画像</p>
        <p><a class="btn-link" download href="/admin/visitors/export.csv?startTime=<%= filters.startTime || '' %>&endTime=<%= filters.endTime || '' %>&ip=<%= encodeURIComponent(filters.ip || '') %>&city=<%= encodeURIComponent(filters.city || '') %>&deviceType=<%= encodeURIComponent(filters.deviceType || '') %>&fingerprint=<%= encodeURIComponent(filters.fingerprint || '') %>">导出当前筛选 CSV</a></p>
      </div>

      <div class="stats-grid">
        <div class="stat-card"><div class="stat-label">今日 PV</div><div class="stat-value"><%= overview.todayPV %></div></div>
        <div class="stat-card"><div class="stat-label">今日 UV</div><div class="stat-value"><%= overview.todayUV %></div></div>
        <div class="stat-card"><div class="stat-label">总 PV</div><div class="stat-value"><%= overview.totalPV %></div></div>
        <div class="stat-card"><div class="stat-label">总 UV</div><div class="stat-value"><%= overview.totalUV %></div></div>
      </div>

      <div class="recent-grid">
        <div class="recent-section">
          <h2>最近 7 天 PV / UV 趋势</h2>
          <canvas id="trendChart" height="120"></canvas>
        </div>
        <div class="recent-section">
          <h2>地域分布</h2>
          <canvas id="regionChart" height="120"></canvas>
        </div>
      </div>

      <div class="recent-grid">
        <div class="recent-section">
          <h2>热门页面 TOP 10</h2>
          <canvas id="pagesChart" height="120"></canvas>
        </div>
      </div>

      <%
        function msToDatetimeLocal(ms) {
          if (!ms) return '';
          var d = new Date(Number(ms));
          if (isNaN(d.getTime())) return '';
          var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
          return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate())
               + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }
      %>

      <%
        function fmtTime(ms) {
          if (!ms) return '—';
          var d = new Date(Number(ms));
          if (isNaN(d.getTime())) return String(ms);
          var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
          return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate())
               + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        }
        function fmtStay(ms) {
          var n = Number(ms);
          if (!n || n <= 0) return '—';
          if (n < 1000) return n + 'ms';
          return (n / 1000).toFixed(1) + 's';
        }
        function maskIp(ip) {
          if (!ip) return '—';
          var parts = ip.split('.');
          if (parts.length === 4) return parts[0] + '.' + parts[1] + '.xx.' + parts[3];
          return ip.replace(/:.+:/, ':xx:');
        }
        function buildPageUrl(p, extraParams) {
          var u = '?page=' + p
            + '&view=' + (view || 'detail')
            + '&startTime=' + (filters.startTime || '')
            + '&endTime=' + (filters.endTime || '')
            + '&ip=' + encodeURIComponent(filters.ip || '')
            + '&fingerprint=' + encodeURIComponent(filters.fingerprint || '')
            + '&city=' + encodeURIComponent(filters.city || '')
            + '&deviceType=' + encodeURIComponent(filters.deviceType || '')
            + '&sortBy=' + (sortBy || 'tracked_at')
            + '&sortDir=' + (sortDir || 'desc');
          return u + '#visitors-table';
        }
        function sortUrl(col) {
          var newDir = (sortBy === col && sortDir === 'asc') ? 'desc' : 'asc';
          return buildPageUrl(1).replace('sortBy=' + (sortBy || 'tracked_at'), 'sortBy=' + col).replace('sortDir=' + (sortDir || 'desc'), 'sortDir=' + newDir);
        }
        function sortArrow(col) {
          if (sortBy !== col) return '';
          return sortDir === 'asc' ? ' ↑' : ' ↓';
        }
      %>

      <div class="recent-section visitors-filter-section">
        <h2>筛选</h2>
        <form method="GET" action="/admin/visitors" class="visitors-filter-grid" data-admin-pjax-form>
          <input type="hidden" name="view" value="<%= view || 'detail' %>">
          <input type="hidden" name="sortBy" value="<%= sortBy || 'tracked_at' %>">
          <input type="hidden" name="sortDir" value="<%= sortDir || 'desc' %>">
          <label class="visitors-field">开始时间<input type="datetime-local" name="startTime" value="<%= msToDatetimeLocal(filters.startTime) %>" class="input"></label>
          <label class="visitors-field">结束时间<input type="datetime-local" name="endTime" value="<%= msToDatetimeLocal(filters.endTime) %>" class="input"></label>
          <label class="visitors-field">IP<input type="text" name="ip" value="<%= filters.ip || '' %>" class="input"></label>
          <label class="visitors-field">指纹（模糊）<input type="text" name="fingerprint" value="<%= filters.fingerprint || '' %>" class="input" placeholder="fp_"></label>
          <label class="visitors-field">城市<input type="text" name="city" value="<%= filters.city || '' %>" class="input"></label>
          <label class="visitors-field">设备类型
            <select name="deviceType" class="input">
              <option value="">全部</option>
              <option value="PC" <%= filters.deviceType === 'PC' ? 'selected' : '' %>>PC</option>
              <option value="手机" <%= filters.deviceType === '手机' ? 'selected' : '' %>>手机</option>
              <option value="平板" <%= filters.deviceType === '平板' ? 'selected' : '' %>>平板</option>
            </select>
          </label>
          <button type="submit" class="btn visitors-filter-btn">应用筛选</button>
        </form>
      </div>

      <div id="table" class="recent-section visitors-table-section">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem">
          <h2 style="margin-bottom:0">
            <% if (view === 'sessions') { %>会话合并<% } else { %>访客明细<% } %>
          </h2>
          <div class="view-toggle">
            <a class="btn-link<%= view !== 'sessions' ? ' view-toggle-active' : '' %>" href="<%= buildPageUrl(1).replace('view=sessions', 'view=detail') %>">明细</a>
            <span style="color:var(--border);margin:0 0.3rem">|</span>
            <a class="btn-link<%= view === 'sessions' ? ' view-toggle-active' : '' %>" href="<%= buildPageUrl(1).replace('view=detail', 'view=sessions') %>">会话</a>
            <span style="color:var(--border);margin:0 0.3rem">|</span>
            <a class="btn-link" href="/admin/visitors/blacklist">黑名单</a>
          </div>
        </div>

        <div id="visitors-table"></div>
        <% if (view === 'sessions') { %>
          <div class="visitors-table-wrap">
            <table class="admin-table visitors-table">
              <thead>
                <tr>
                  <th>会话 ID</th>
                  <th>指纹</th>
                  <th>开始时间</th>
                  <th>结束时间</th>
                  <th>页面数</th>
                  <th>总停留</th>
                  <th>访问路径</th>
                </tr>
              </thead>
              <tbody>
                <% if (!sessionsPage || sessionsPage.rows.length === 0) { %>
                  <tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:2rem">暂无会话数据</td></tr>
                <% } else { %>
                  <% sessionsPage.rows.forEach(function(row) { %>
                    <tr>
                      <td>#<%= row.id %></td>
                      <td class="cell-fingerprint"><%= (row.fingerprint_id || '').slice(0, 12) %>…</td>
                      <td style="white-space:nowrap"><%= fmtTime(row.start_time) %></td>
                      <td style="white-space:nowrap"><%= fmtTime(row.end_time) %></td>
                      <td><%= row.page_count %></td>
                      <td><%= fmtStay(row.total_duration) %></td>
                      <td class="cell-path"><%= (row.paths || '—').replace(/,/g, ' → ') %></td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (sessionsPage) { %>
            <%
              var curPage = sessionsPage.page;
              var totalPages = sessionsPage.totalPages || 1;
              var prevPage = Math.max(1, curPage - 1);
              var nextPage = Math.min(totalPages, curPage + 1);
            %>
            <div class="visitors-pagination">
              <div class="visitors-pagination-meta">共 <%=sessionsPage.total %> 条，第 <%= curPage %> / <%= totalPages %> 页</div>
              <div class="visitors-pagination-actions">
                <% if (curPage <= 1) { %><span class="btn-link pagination-disabled" aria-disabled="true">← 上一页</span><% } else { %><a href="<%- buildPageUrl(prevPage) %>" class="btn-link">← 上一页</a><% } %>
                <% if (curPage >= totalPages) { %><span class="btn-link pagination-disabled" aria-disabled="true">下一页 →</span><% } else { %><a href="<%- buildPageUrl(nextPage) %>" class="btn-link">下一页 →</a><% } %>
              </div>
            </div>
          <% } %>

        <% } else { %>
          <div class="visitors-table-wrap">
            <table class="admin-table visitors-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th class="sort-header"><a href="<%= sortUrl('tracked_at') %>">时间<%= sortArrow('tracked_at') %></a></th>
                  <th class="sort-header"><a href="<%= sortUrl('ip') %>">IP<%= sortArrow('ip') %></a></th>
                  <th>页面</th>
                  <th>设备</th>
                  <th>地域</th>
                  <th>网络</th>
                  <th class="sort-header"><a href="<%= sortUrl('stay_duration_ms') %>">停留<%= sortArrow('stay_duration_ms') %></a></th>
                  <th>指纹</th>
                  <th>操作</th>
                </tr>
              </thead>
              <tbody>
                <% if (!visitorsPage || visitorsPage.rows.length === 0) { %>
                  <tr><td colspan="10" style="text-align:center;color:var(--text-muted);padding:2rem">暂无数据</td></tr>
                <% } else { %>
                  <% visitorsPage.rows.forEach(function(row) { %>
                    <tr<% if (row.is_bot) { %> class="row-bot"<% } %>>
                      <td><%= row.id %></td>
                      <td style="white-space:nowrap"><%= fmtTime(row.tracked_at) %></td>
                      <td><%= maskIp(row.ip) %></td>
                      <td class="cell-path"><%= row.path || '/' %></td>
                      <td style="white-space:nowrap">
                        <%= row.device_type %> · <%= row.os_name %> · <%= row.browser_name %>
                        <% if (row.is_bot) { %><span class="badge-bot">爬虫</span><% } %>
                      </td>
                      <td><%= [row.country, row.province, row.city].filter(Boolean).join('/') || '—' %></td>
                      <td><%= (row.network_type && String(row.network_type).trim()) ? row.network_type : '—' %></td>
                      <td><%= fmtStay(row.stay_duration_ms) %></td>
                      <td class="cell-fingerprint"><%= (row.fingerprint_id || '').slice(0, 12) %>…</td>
                      <td style="white-space:nowrap">
                        <a class="btn-link" href="/admin/visitors/fingerprint?fp=<%= encodeURIComponent(row.fingerprint_id || '') %>">路径</a>
                        <span class="action-sep">|</span>
                        <a class="btn-link" href="/admin/visitor/<%= row.id %>">详情</a>
                        <span class="action-sep">|</span>
                        <button class="btn-link btn-danger-text" type="button" data-blacklist-add data-ip="<%= row.ip || '' %>">拉黑</button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (visitorsPage) { %>
            <%
              var curPage = visitorsPage.page;
              var totalPages = visitorsPage.totalPages || 1;
              var prevPage = Math.max(1, curPage - 1);
              var nextPage = Math.min(totalPages, curPage + 1);
            %>
            <div class="visitors-pagination">
              <div class="visitors-pagination-meta">共 <%=visitorsPage.total %> 条，第 <%= curPage %> / <%= totalPages %> 页</div>
              <div class="visitors-pagination-actions">
                <% if (curPage <= 1) { %><span class="btn-link pagination-disabled" aria-disabled="true">← 上一页</span><% } else { %><a href="<%- buildPageUrl(prevPage) %>" class="btn-link">← 上一页</a><% } %>
                <% if (curPage >= totalPages) { %><span class="btn-link pagination-disabled" aria-disabled="true">下一页 →</span><% } else { %><a href="<%- buildPageUrl(nextPage) %>" class="btn-link">下一页 →</a><% } %>
              </div>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
    <script id="visitor-chart-data" type="application/json"><%- JSON.stringify({ trendRows: trendRows || [], regionRows: regionRows || [], topPages: topPages || [] }).replace(/</g, '\\u003c') %></script>
  </main>
  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
