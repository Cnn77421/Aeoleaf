<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <%- include('partials/styles') %>
  <script src="<%= asset('/vendor/chartjs/chart.umd.min.js') %>"></script>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'visitors' }) %>

  <main class="admin-main admin-main--wide">
    <div class="dashboard-container">
      <div class="dashboard-welcome visitors-heading visitors-heading--redesigned">
        <div>
          <span class="admin-eyebrow">数据与系统 / Analytics</span>
          <h1>访客分析</h1>
          <p class="dashboard-subtitle">掌握访问趋势、内容表现与访客行为</p>
        </div>
        <div class="admin-heading-actions">
          <span class="visitors-period"><i class="ti ti-calendar-stats" aria-hidden="true"></i> 最近 7 天</span>
          <a class="btn-sm visitors-export" download href="/admin/visitors/export.csv?startTime=<%= filters.startTime || '' %>&endTime=<%= filters.endTime || '' %>&ip=<%= encodeURIComponent(filters.ip || '') %>&city=<%= encodeURIComponent(filters.city || '') %>&deviceType=<%= encodeURIComponent(filters.deviceType || '') %>&fingerprint=<%= encodeURIComponent(filters.fingerprint || '') %>"><i class="ti ti-download" aria-hidden="true"></i> 导出 CSV</a>
        </div>
      </div>

      <div class="visitors-subnav">
        <div class="visitors-page-tabs" role="tablist" aria-label="访客分析页面分区">
          <button type="button" id="visitors-tab-overview" class="active" role="tab" aria-selected="true" aria-controls="analytics-overview" tabindex="0">数据概览</button>
          <button type="button" id="visitors-tab-records" role="tab" aria-selected="false" aria-controls="visitors-records" tabindex="-1">访客记录</button>
        </div>
        <a class="visitors-advanced-link" href="/admin/visitors/advanced"><i class="ti ti-chart-dots-3" aria-hidden="true"></i> 高级分析</a>
      </div>

      <div id="analytics-overview" class="analytics-overview-panel" role="tabpanel" aria-labelledby="visitors-tab-overview">
      <section class="analytics-card analytics-traffic-card">
        <header class="analytics-card-header">
          <div>
            <h2>流量趋势</h2>
            <p>最近 7 天页面访问量与独立访客</p>
          </div>
          <div class="analytics-legend" aria-label="图例">
            <span><i class="analytics-legend-primary"></i> 页面浏览（PV）</span>
            <span><i class="analytics-legend-secondary"></i> 独立访客（UV）</span>
          </div>
        </header>
        <div class="analytics-card-content analytics-chart-frame analytics-chart-frame--large">
          <% if (trendRows && trendRows.length) { %><canvas id="trendChart"></canvas><% } else { %><div class="analytics-chart-empty"><i class="ti ti-chart-area-line"></i><span>最近 7 天暂无流量数据</span></div><% } %>
        </div>
      </section>

      <%
        var pvDelta = overview.yesterdayPV > 0
          ? Math.round(((overview.todayPV - overview.yesterdayPV) / overview.yesterdayPV) * 1000) / 10
          : null;
      %>
      <div class="visitors-metrics-grid">
        <article class="analytics-metric-card">
          <header><span>今日浏览</span><span class="analytics-metric-icon"><i class="ti ti-chart-line"></i></span></header>
          <strong><%= Number(overview.todayPV || 0).toLocaleString('zh-CN') %></strong>
          <p<% if (pvDelta !== null) { %> class="<%= pvDelta >= 0 ? 'is-positive' : 'is-negative' %>"<% } %>><% if (pvDelta === null) { %>昨日无访问记录<% } else { %><%= pvDelta >= 0 ? '+' : '' %><%= pvDelta %>% 较昨日<% } %></p>
        </article>
        <article class="analytics-metric-card">
          <header><span>今日访客</span><span class="analytics-metric-icon"><i class="ti ti-users"></i></span></header>
          <strong><%= Number(overview.todayUV || 0).toLocaleString('zh-CN') %></strong>
          <p>今日独立访客</p>
        </article>
        <article class="analytics-metric-card">
          <header><span>累计浏览</span><span class="analytics-metric-icon"><i class="ti ti-activity"></i></span></header>
          <strong><%= Number(overview.totalPV || 0).toLocaleString('zh-CN') %></strong>
          <p>全部页面访问次数</p>
        </article>
        <article class="analytics-metric-card">
          <header><span>累计访客</span><span class="analytics-metric-icon"><i class="ti ti-user-scan"></i></span></header>
          <strong><%= Number(overview.totalUV || 0).toLocaleString('zh-CN') %></strong>
          <p>全部独立访客</p>
        </article>
      </div>

      <div class="analytics-insights-grid">
        <section class="analytics-card analytics-card--wide">
          <header class="analytics-card-header">
            <div><h2>热门页面</h2><p>访问量最高的页面 TOP 10</p></div>
          </header>
          <div class="analytics-card-content analytics-chart-frame"><% if (topPages && topPages.length) { %><canvas id="pagesChart"></canvas><% } else { %><div class="analytics-chart-empty"><i class="ti ti-chart-bar"></i><span>暂无热门页面数据</span></div><% } %></div>
        </section>
        <section class="analytics-card analytics-card--narrow">
          <header class="analytics-card-header">
            <div><h2>地域分布</h2><p>主要访客来源地区</p></div>
          </header>
          <div class="analytics-card-content analytics-chart-frame"><% if (regionRows && regionRows.length) { %><canvas id="regionChart"></canvas><% } else { %><div class="analytics-chart-empty"><i class="ti ti-map-pin"></i><span>暂无地域分布数据</span></div><% } %></div>
        </section>
      </div>
      </div>

      <%
        function msToDatetimeLocal(ms) {
          if (!ms) return '';
          var d = new Date(Number(ms));
          if (isNaN(d.getTime())) return '';
          var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
          return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate())
               + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }
      %>

      <%
        function fmtTime(ms) {
          if (!ms) return '—';
          var d = new Date(Number(ms));
          if (isNaN(d.getTime())) return String(ms);
          var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
          return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate())
               + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        }
        function fmtStay(ms) {
          var n = Number(ms);
          if (!n || n <= 0) return '—';
          if (n < 1000) return n + 'ms';
          return (n / 1000).toFixed(1) + 's';
        }
        function maskIp(ip) {
          if (!ip) return '—';
          var parts = ip.split('.');
          if (parts.length === 4) return parts[0] + '.' + parts[1] + '.xx.' + parts[3];
          return ip.replace(/:.+:/, ':xx:');
        }
        function buildPageUrl(p, extraParams) {
          var u = '?page=' + p
            + '&view=' + (view || 'detail')
            + '&startTime=' + (filters.startTime || '')
            + '&endTime=' + (filters.endTime || '')
            + '&ip=' + encodeURIComponent(filters.ip || '')
            + '&fingerprint=' + encodeURIComponent(filters.fingerprint || '')
            + '&city=' + encodeURIComponent(filters.city || '')
            + '&deviceType=' + encodeURIComponent(filters.deviceType || '')
            + '&sortBy=' + (sortBy || 'tracked_at')
            + '&sortDir=' + (sortDir || 'desc');
          return u + '&section=records';
        }
        function sortUrl(col) {
          var newDir = (sortBy === col && sortDir === 'asc') ? 'desc' : 'asc';
          return buildPageUrl(1).replace('sortBy=' + (sortBy || 'tracked_at'), 'sortBy=' + col).replace('sortDir=' + (sortDir || 'desc'), 'sortDir=' + newDir);
        }
        function sortArrow(col) {
          if (sortBy !== col) return '';
          return sortDir === 'asc' ? ' ↑' : ' ↓';
        }
      %>

      <%
        var activeFilterCount = ['startTime', 'endTime', 'ip', 'fingerprint', 'city', 'deviceType']
          .filter(function(key) { return Boolean(filters[key]); }).length;
      %>
      <div id="visitors-records" class="visitors-records-panel" role="tabpanel" aria-labelledby="visitors-tab-records" hidden>
      <section class="analytics-card visitors-filter-section">
        <header class="analytics-card-header visitors-filter-header">
          <div><h2>筛选条件</h2><p>按时间、身份或设备缩小访客记录范围</p></div>
          <% if (activeFilterCount > 0) { %><span class="visitors-filter-count"><%= activeFilterCount %> 项已启用</span><% } %>
        </header>
        <form method="GET" action="/admin/visitors" class="visitors-filter-grid" data-admin-pjax-form>
          <input type="hidden" name="section" value="records">
          <input type="hidden" name="view" value="<%= view || 'detail' %>">
          <input type="hidden" name="sortBy" value="<%= sortBy || 'tracked_at' %>">
          <input type="hidden" name="sortDir" value="<%= sortDir || 'desc' %>">
          <label class="visitors-field">开始时间<input type="datetime-local" name="startTime" value="<%= msToDatetimeLocal(filters.startTime) %>" class="input"></label>
          <label class="visitors-field">结束时间<input type="datetime-local" name="endTime" value="<%= msToDatetimeLocal(filters.endTime) %>" class="input"></label>
          <label class="visitors-field">IP<input type="text" name="ip" value="<%= filters.ip || '' %>" class="input"></label>
          <label class="visitors-field">指纹（模糊）<input type="text" name="fingerprint" value="<%= filters.fingerprint || '' %>" class="input" placeholder="fp_"></label>
          <label class="visitors-field">城市<input type="text" name="city" value="<%= filters.city || '' %>" class="input"></label>
          <label class="visitors-field">设备类型
            <select name="deviceType" class="input">
              <option value="">全部</option>
              <option value="PC" <%= filters.deviceType === 'PC' ? 'selected' : '' %>>PC</option>
              <option value="手机" <%= filters.deviceType === '手机' ? 'selected' : '' %>>手机</option>
              <option value="平板" <%= filters.deviceType === '平板' ? 'selected' : '' %>>平板</option>
            </select>
          </label>
          <div class="visitors-filter-actions">
            <a href="/admin/visitors?view=<%= view || 'detail' %>&section=records" class="btn-link">重置</a>
            <button type="submit" class="btn-primary visitors-filter-btn"><i class="ti ti-filter"></i> 应用筛选</button>
          </div>
        </form>
      </section>

      <section id="table" class="analytics-card visitors-table-section">
        <header class="analytics-card-header visitors-table-header">
          <div>
            <h2><% if (view === 'sessions') { %>访客会话<% } else { %>原始访问明细<% } %></h2>
            <p><% if (view === 'sessions') { %>每行代表一次完整会话，聚合设备、路径和参与度<% } else { %>用于排障的逐次访问原始记录<% } %></p>
          </div>
          <div class="view-toggle">
            <a class="btn-link<%= view === 'sessions' ? ' view-toggle-active' : '' %>" href="<%= buildPageUrl(1).replace('view=detail', 'view=sessions') %>">会话</a>
            <a class="btn-link<%= view !== 'sessions' ? ' view-toggle-active' : '' %>" href="<%= buildPageUrl(1).replace('view=sessions', 'view=detail') %>">原始明细</a>
            <a class="btn-link view-toggle-danger" href="/admin/visitors/blacklist">黑名单</a>
          </div>
        </header>

        <div id="visitors-table"></div>
        <% if (view === 'sessions') { %>
          <div class="visitors-table-wrap">
            <table class="admin-table visitors-table">
              <thead>
                <tr>
                  <th>会话</th>
                  <th>访客环境</th>
                  <th>访问旅程</th>
                  <th>参与度</th>
                  <th>状态</th>
                  <th>操作</th>
                </tr>
              </thead>
              <tbody>
                <% if (!sessionsPage || sessionsPage.rows.length === 0) { %>
                  <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:2rem">暂无公开站点会话</td></tr>
                <% } else { %>
                  <% sessionsPage.rows.forEach(function(row) { %>
                    <%
                      var publicDuration = Number(row.public_total_duration || 0);
                      var quality = row.is_bot ? 'bot' : (publicDuration >= 30000 || Number(row.avg_scroll || 0) >= 75 ? 'engaged' : (publicDuration > 0 && publicDuration < 5000 ? 'quick' : 'normal'));
                      var qualityLabel = quality === 'bot' ? '机器人' : (quality === 'engaged' ? '高参与' : (quality === 'quick' ? '快速离开' : '普通'));
                    %>
                    <tr class="visitor-session-row visitor-session-row--<%= quality %>">
                      <td class="visitor-session-identity"><strong>#<%= row.id %> <% if (row.is_returning) { %><span class="visitor-returning">回访</span><% } else { %><span class="visitor-new">新访客</span><% } %></strong><small><%= fmtTime(row.public_start_time || row.start_time) %></small><button type="button" class="visitor-copy" data-copy-value="<%= row.fingerprint_id || '' %>" title="复制完整指纹"><%= (row.fingerprint_id || '无指纹').slice(0, 12) %><%= row.fingerprint_id && row.fingerprint_id.length > 12 ? '…' : '' %></button></td>
                      <td class="visitor-session-device"><strong><i class="ti <%= row.device_type === '手机' ? 'ti-device-mobile' : 'ti-device-desktop' %>"></i> <%= row.device_type || '未知设备' %></strong><small><%= [row.os_name, row.browser_name].filter(Boolean).join(' · ') || '环境未知' %></small><small><%= row.city || '未知地域' %> · <%= maskIp(row.ip) %></small></td>
                      <td class="visitor-session-journey"><strong><%= row.entry_path || '/' %></strong><span><i class="ti ti-arrow-right"></i></span><strong><%= row.exit_path || row.entry_path || '/' %></strong><small><%= row.public_page_count || 0 %> 个页面</small></td>
                      <td class="visitor-session-engagement"><strong><%= fmtStay(publicDuration) %></strong><small>平均滚动 <%= row.avg_scroll ? Number(row.avg_scroll).toFixed(0) + '%' : '—' %></small></td>
                      <td><span class="visitor-quality visitor-quality--<%= quality %>"><%= qualityLabel %></span></td>
                      <td class="visitor-session-actions"><button type="button" class="btn-secondary btn-sm" data-visitor-quick data-session="<%= row.id %>" data-time="<%= fmtTime(row.public_start_time || row.start_time) %>" data-device="<%= [row.device_type, row.os_name, row.browser_name].filter(Boolean).join(' · ') %>" data-location="<%= row.city || '未知地域' %>" data-ip="<%= maskIp(row.ip) %>" data-entry="<%= row.entry_path || '/' %>" data-exit="<%= row.exit_path || row.entry_path || '/' %>" data-pages="<%= row.public_page_count || 0 %>" data-duration="<%= fmtStay(publicDuration) %>" data-scroll="<%= row.avg_scroll ? Number(row.avg_scroll).toFixed(0) + '%' : '—' %>" data-quality="<%= qualityLabel %>" data-detail="/admin/visitor/<%= row.latest_visitor_id %>">快速查看</button></td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (sessionsPage) { %>
            <%
              var curPage = sessionsPage.page;
              var totalPages = sessionsPage.totalPages || 1;
              var prevPage = Math.max(1, curPage - 1);
              var nextPage = Math.min(totalPages, curPage + 1);
            %>
            <div class="visitors-pagination">
              <div class="visitors-pagination-meta">共 <%=sessionsPage.total %> 条，第 <%= curPage %> / <%= totalPages %> 页</div>
              <div class="visitors-pagination-actions">
                <% if (curPage <= 1) { %><span class="btn-link pagination-disabled" aria-disabled="true">← 上一页</span><% } else { %><a href="<%- buildPageUrl(prevPage) %>" class="btn-link">← 上一页</a><% } %>
                <% if (curPage >= totalPages) { %><span class="btn-link pagination-disabled" aria-disabled="true">下一页 →</span><% } else { %><a href="<%- buildPageUrl(nextPage) %>" class="btn-link">下一页 →</a><% } %>
              </div>
            </div>
          <% } %>

        <% } else { %>
          <div class="visitors-table-wrap">
            <table class="admin-table visitors-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th class="sort-header"><a href="<%= sortUrl('tracked_at') %>">时间<%= sortArrow('tracked_at') %></a></th>
                  <th class="sort-header"><a href="<%= sortUrl('ip') %>">IP<%= sortArrow('ip') %></a></th>
                  <th>页面</th>
                  <th>设备</th>
                  <th>地域</th>
                  <th>网络</th>
                  <th class="sort-header"><a href="<%= sortUrl('stay_duration_ms') %>">停留<%= sortArrow('stay_duration_ms') %></a></th>
                  <th>指纹</th>
                  <th>操作</th>
                </tr>
              </thead>
              <tbody>
                <% if (!visitorsPage || visitorsPage.rows.length === 0) { %>
                  <tr><td colspan="10" style="text-align:center;color:var(--text-muted);padding:2rem">暂无数据</td></tr>
                <% } else { %>
                  <% visitorsPage.rows.forEach(function(row) { %>
                    <tr<% if (row.is_bot) { %> class="row-bot"<% } %>>
                      <td><%= row.id %></td>
                      <td style="white-space:nowrap"><%= fmtTime(row.tracked_at) %></td>
                      <td><%= maskIp(row.ip) %></td>
                      <td class="cell-path"><%= row.path || '/' %></td>
                      <td style="white-space:nowrap">
                        <%= row.device_type %> · <%= row.os_name %> · <%= row.browser_name %>
                        <% if (row.is_bot) { %><span class="badge-bot">爬虫</span><% } %>
                      </td>
                      <td><%= [row.country, row.province, row.city].filter(Boolean).join('/') || '—' %></td>
                      <td><%= (row.network_type && String(row.network_type).trim()) ? row.network_type : '—' %></td>
                      <td><%= fmtStay(row.stay_duration_ms) %></td>
                      <td class="cell-fingerprint"><%= (row.fingerprint_id || '').slice(0, 12) %>…</td>
                      <td style="white-space:nowrap">
                        <a class="btn-link" href="/admin/visitors/fingerprint?fp=<%= encodeURIComponent(row.fingerprint_id || '') %>">路径</a>
                        <span class="action-sep">|</span>
                        <a class="btn-link" href="/admin/visitor/<%= row.id %>">详情</a>
                        <span class="action-sep">|</span>
                        <button class="btn-link btn-danger-text" type="button" data-blacklist-add data-ip="<%= row.ip || '' %>">拉黑</button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (visitorsPage) { %>
            <%
              var curPage = visitorsPage.page;
              var totalPages = visitorsPage.totalPages || 1;
              var prevPage = Math.max(1, curPage - 1);
              var nextPage = Math.min(totalPages, curPage + 1);
            %>
            <div class="visitors-pagination">
              <div class="visitors-pagination-meta">共 <%=visitorsPage.total %> 条，第 <%= curPage %> / <%= totalPages %> 页</div>
              <div class="visitors-pagination-actions">
                <% if (curPage <= 1) { %><span class="btn-link pagination-disabled" aria-disabled="true">← 上一页</span><% } else { %><a href="<%- buildPageUrl(prevPage) %>" class="btn-link">← 上一页</a><% } %>
                <% if (curPage >= totalPages) { %><span class="btn-link pagination-disabled" aria-disabled="true">下一页 →</span><% } else { %><a href="<%- buildPageUrl(nextPage) %>" class="btn-link">下一页 →</a><% } %>
              </div>
            </div>
          <% } %>
        <% } %>
      </section>
      </div>
    </div>
    <script id="visitor-chart-data" type="application/json"><%- JSON.stringify({ trendRows: trendRows || [], regionRows: regionRows || [], topPages: topPages || [] }).replace(/</g, '\\u003c') %></script>
  <button class="visitor-quick-backdrop" type="button" data-visitor-quick-close hidden aria-label="关闭快速详情"></button>
  <aside class="visitor-quick-drawer" data-visitor-quick-drawer aria-hidden="true" aria-labelledby="visitor-quick-title">
    <header><div><span class="admin-eyebrow">访客会话</span><h2 id="visitor-quick-title">快速详情</h2></div><button type="button" class="admin-icon-button" data-visitor-quick-close aria-label="关闭"><i class="ti ti-x"></i></button></header>
    <div class="visitor-quick-summary"><strong data-visitor-quick-quality>—</strong><span data-visitor-quick-time>—</span></div>
    <dl>
      <div><dt>设备环境</dt><dd data-visitor-quick-device>—</dd></div>
      <div><dt>地域 / IP</dt><dd><span data-visitor-quick-location>—</span> · <span data-visitor-quick-ip>—</span></dd></div>
      <div><dt>访问旅程</dt><dd><span data-visitor-quick-entry>—</span> → <span data-visitor-quick-exit>—</span></dd></div>
      <div><dt>页面 / 停留</dt><dd><span data-visitor-quick-pages>—</span> 页 · <span data-visitor-quick-duration>—</span></dd></div>
      <div><dt>平均滚动</dt><dd data-visitor-quick-scroll>—</dd></div>
    </dl>
    <a class="btn-primary" data-visitor-quick-detail href="/admin/visitors">查看完整详情</a>
  </aside>
  </main>
  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
