<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <%- include('partials/styles') %>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'dashboard' }) %>
  <main class="admin-main">
    <div class="dashboard-container">
      <div class="dashboard-welcome">
        <h1>内容概览</h1>
        <p class="dashboard-subtitle">管理文章、作品与站点内容</p>
      </div>

      <div class="stats-grid">
        <div class="stat-card stat-published">
          <div class="stat-header">
            <span class="stat-label">已发布文章</span>
            <span class="stat-badge"><i class="ti ti-world"></i></span>
          </div>
          <div class="stat-value"><%= stats.postsPublished %></div>
        </div>
        <div class="stat-card stat-draft">
          <div class="stat-header">
            <span class="stat-label">文章草稿</span>
            <span class="stat-badge"><i class="ti ti-pencil"></i></span>
          </div>
          <div class="stat-value"><%= stats.postsDraft %></div>
        </div>
        <div class="stat-card stat-works">
          <div class="stat-header">
            <span class="stat-label">作品项目</span>
            <span class="stat-badge"><i class="ti ti-folders"></i></span>
          </div>
          <div class="stat-value"><%= stats.worksTotal %></div>
        </div>
        <div class="stat-card stat-messages">
          <div class="stat-header">
            <span class="stat-label">待审核留言</span>
            <span class="stat-badge"><i class="ti ti-message"></i></span>
          </div>
          <div class="stat-value"><%= stats.guestbookPending %></div>
          <div class="stat-note">共 <%= stats.guestbookTotal %> 条留言</div>
        </div>
      </div>

      <div class="quick-actions">
        <a href="/admin/posts/new" class="action-card action-post">
          <div class="action-content">
            <h3><i class="ti ti-file-plus"></i> 新建文章</h3>
            <p>撰写并发布一篇博客文章</p>
          </div>
          <span class="action-arrow">→</span>
        </a>
        <a href="/admin/works/new" class="action-card action-work">
          <div class="action-content">
            <h3><i class="ti ti-folder-plus"></i> 新建作品</h3>
            <p>添加一个新的作品项目</p>
          </div>
          <span class="action-arrow">→</span>
        </a>
        <a href="/admin/guestbook" class="action-card action-message">
          <div class="action-content">
            <h3><i class="ti ti-message"></i> 管理留言</h3>
            <p><%= stats.guestbookPending ? stats.guestbookPending + ' 条留言等待审核' : '当前没有待审核留言' %></p>
          </div>
          <span class="action-arrow">→</span>
        </a>
        <a href="/admin/media" class="action-card action-media">
          <div class="action-content">
            <h3><i class="ti ti-photo"></i> 浏览媒体库</h3>
            <p>查找并复用站点图片</p>
          </div>
          <span class="action-arrow">→</span>
        </a>
      </div>
      <div class="recent-grid">
        <div class="recent-section">
          <h2>最近文章</h2>
          <% if (recentPosts.length === 0) { %>
            <p class="empty-state">暂无文章，<a href="/admin/posts/new">创建第一篇文章</a></p>
          <% } else { %>
            <div class="recent-list">
              <% recentPosts.forEach(post => { %>
              <div class="recent-item">
                <a href="/admin/posts/<%= post.id %>/edit" class="recent-title"><%= post.title %></a>
                <span class="badge badge-<%= post.status %>"><%= post.status %></span>
              </div>
              <% }); %>
            </div>
            <a href="/admin/posts" class="view-all">查看全部文章 →</a>
          <% } %>
        </div>
        <div class="recent-section">
          <h2>最近作品</h2>
          <% if (recentWorks.length === 0) { %>
            <p class="empty-state">暂无作品，<a href="/admin/works/new">创建第一个作品</a></p>
          <% } else { %>
            <div class="recent-list">
              <% recentWorks.forEach(work => { %>
              <div class="recent-item">
                <a href="/admin/works/<%= work.id %>/edit" class="recent-title"><%= work.title %></a>
                <span class="recent-meta"><%= work.year || '-' %></span>
              </div>
              <% }); %>
            </div>
            <a href="/admin/works" class="view-all">查看全部作品 →</a>
          <% } %>
        </div>
      </div>
    </div>
  </main>
  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
