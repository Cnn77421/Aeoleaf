<% const isNew = !post; %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <a href="/">aeoleaf <span>风叶</span></a>
    </div>
    <nav class="admin-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/posts">Posts</a>
      <a href="/admin/works">Works</a>
      <a href="/admin/visitors">Visitors</a>
      <a href="/admin/settings">Settings</a>
    </nav>
    <div class="admin-footer">
      <a href="/" target="_blank">View Site</a>
      <form method="POST" action="/admin/logout" style="margin-top:0.5rem">
        <button type="submit" class="btn-link">Log Out</button>
      </form>
    </div>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1><%= isNew ? 'New Post' : 'Edit Post' %></h1>
    </div>
    <form id="post-form" class="edit-form">
      <div class="form-main">
        <input type="text" name="title" placeholder="Title" value="<%= post ? post.title : '' %>" required class="input-title">
        <input type="text" name="slug" placeholder="slug-auto-generated" value="<%= post ? post.slug : '' %>" class="input-slug">
        <div class="form-group">
          <label>Content</label>
          <textarea name="content" id="content-editor"><%= post ? post.content : '' %></textarea>
        </div>
      </div>
      <div class="form-sidebar">
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
          </select>
        </div>
        <div class="form-group">
          <label>Excerpt</label>
          <textarea name="excerpt" rows="3"><%= post ? post.excerpt : '' %></textarea>
        </div>
        <div class="form-group">
          <label>Tags (comma-separated)</label>
          <input type="text" name="tags" value="<%= post ? post.tags.join(', ') : '' %>">
        </div>
        <div class="form-group">
          <label>Cover Image</label>
          <% if (post && post.cover_image) { %>
            <img src="<%= post.cover_image %>" class="preview-img">
          <% } %>
          <input type="file" id="cover-upload" accept="image/*">
        </div>
        <button type="submit" class="btn-primary btn-block">Save</button>
        <% if (post) { %>
          <a href="/blog/<%= post.slug %>" target="_blank" class="btn-link">View Post</a>
          <button type="button" class="btn-danger btn-sm" onclick="deletePost(<%= post.id %>)">Delete</button>
        <% } %>
      </div>
    </form>
    <script>
    window.__AEOL_ADMIN_CTX = { postId: <%= post ? post.id : 'null' %>, workId: null };
    </script>
  </main>
  <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/editor.js"></script>
</body>
</html>
