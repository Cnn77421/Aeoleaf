<% const isNew = !post; %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('/vendor/easymde/easymde.min.css') %>">
  <%- include('partials/styles') %>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'posts' }) %>
  <main class="admin-main" data-post-id="<%= post ? post.id : '' %>">
    <div class="admin-header">
      <div><h1><%= isNew ? '新建文章' : '编辑文章' %></h1><p class="dashboard-subtitle">专注写作，发布设置位于右侧</p></div>
      <button type="submit" form="post-form" class="btn-primary admin-mobile-save"><i class="ti ti-device-floppy" aria-hidden="true"></i> 保存文章</button>
    </div>
    <form id="post-form" class="edit-form">
      <div class="form-main">
        <input type="text" name="title" placeholder="文章标题" aria-label="文章标题" value="<%= post ? post.title : '' %>" required class="input-title">
        <input type="text" name="slug" placeholder="URL 别名（留空自动生成）" aria-label="URL 别名" value="<%= post ? post.slug : '' %>" class="input-slug">
        <div class="form-group">
          <label for="content-editor">正文内容</label>
          <textarea name="content" id="content-editor"><%= post ? post.content : '' %></textarea>
        </div>
      </div>
      <div class="form-sidebar">
        <% if (performance) { %>
        <section class="post-performance" aria-labelledby="post-performance-title">
          <div class="post-performance-heading"><strong id="post-performance-title">文章表现</strong><a href="/admin/visitors">详情</a></div>
          <div class="post-performance-grid">
            <span><b><%= performance.pv %></b><small>浏览</small></span>
            <span><b><%= performance.uv %></b><small>访客</small></span>
            <span><b><%= performance.avgStay %>s</b><small>平均停留</small></span>
            <span><b><%= performance.avgScroll %>%</b><small>阅读深度</small></span>
          </div>
        </section>
        <% } %>
        <div class="form-group">
          <label for="post-status">发布状态</label>
          <select id="post-status" name="status">
            <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>草稿</option>
            <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>已发布</option>
          </select>
        </div>
        <div class="form-group">
          <label for="post-excerpt">文章摘要</label>
          <textarea id="post-excerpt" name="excerpt" rows="3"><%= post ? post.excerpt : '' %></textarea>
        </div>
        <div class="form-group">
          <label for="post-tags">标签（逗号分隔）</label>
          <input id="post-tags" type="text" name="tags" value="<%= post ? post.tags.join(', ') : '' %>">
        </div>
        <div class="form-group">
          <label for="cover-upload">封面图片</label>
          <% if (post && post.cover_image) { %>
            <img src="<%= post.cover_image %>" class="preview-img">
          <% } %>
          <input type="file" id="cover-upload" accept="image/*">
        </div>
        <button type="submit" class="btn-primary btn-block"><i class="ti ti-device-floppy"></i> 保存文章</button>
        <% if (post) { %>
          <a href="/blog/<%= post.slug %>" target="_blank" class="btn-link"><i class="ti ti-external-link"></i> 查看文章</a>
          <button type="button" class="btn-danger btn-sm" onclick="deletePost(<%= post.id %>)"><i class="ti ti-trash"></i> 删除</button>
        <% } %>
      </div>
    </form>
  </main>
  <script src="<%= asset('/vendor/easymde/easymde.min.js') %>"></script>
  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
