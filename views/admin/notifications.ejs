<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= title %></title><%- include('partials/styles') %></head>
<body class="admin-body"><%- include('partials/sidebar', { activePage: 'notifications' }) %>
<main class="admin-main">
  <div class="admin-header"><div><h1>通知中心</h1><p class="dashboard-subtitle">查看发布、备份、安全和内容审核事件</p></div><% if (counts.unread) { %><form method="POST" action="/admin/notifications/read-all" data-admin-async-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit"><i class="ti ti-checks"></i> 全部已读</button></form><% } %></div>
  <section class="notification-metrics"><article><small>全部通知</small><strong><%= counts.total || 0 %></strong></article><article><small>未读</small><strong><%= counts.unread || 0 %></strong></article><article><small>错误</small><strong><%= counts.errors || 0 %></strong></article></section>
  <nav class="visitors-page-tabs notification-tabs" aria-label="通知筛选"><a href="/admin/notifications" class="<%= filter==='all'?'active':'' %>">全部</a><a href="/admin/notifications?filter=unread" class="<%= filter==='unread'?'active':'' %>">未读</a><a href="/admin/notifications?filter=error" class="<%= filter==='error'?'active':'' %>">错误</a><a href="/admin/notifications?filter=warning" class="<%= filter==='warning'?'active':'' %>">警告</a></nav>
  <section class="notification-list">
  <% if (!notifications.length) { %><div class="empty-state">当前筛选下没有通知</div><% } %>
  <% notifications.forEach(item => { %><article class="notification-item notification-<%= item.severity %><%= item.read_at ? '' : ' is-unread' %>"><span class="notification-icon"><i class="ti ti-<%= item.severity==='error'?'alert-triangle':item.severity==='warning'?'alert-circle':item.severity==='success'?'circle-check':'bell' %>"></i></span><div><header><strong><%= item.title %></strong><time><%= item.created_at %></time></header><p><%= item.message %></p><footer><span><%= item.source_action %></span><div><% if (item.action_url) { %><a class="btn-sm" href="<%= item.action_url %>">查看</a><% } %><% if (!item.read_at) { %><form method="POST" action="/admin/notifications/<%= item.id %>/read" data-admin-async-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-sm" type="submit">标为已读</button></form><% } %><form method="POST" action="/admin/notifications/<%= item.id %>/delete" data-admin-async-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-sm btn-danger" type="submit">清理</button></form></div></footer></div></article><% }) %>
  </section>
</main><script src="<%= asset('/js/toast.js') %>"></script><script src="<%= asset('/js/admin.js') %>"></script></body></html>
