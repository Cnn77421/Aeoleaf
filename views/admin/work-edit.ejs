<% const isNew = !work; %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('/vendor/easymde/easymde.min.css') %>">
  <%- include('partials/styles') %>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'works' }) %>
  <main class="admin-main" data-work-id="<%= work ? work.id : '' %>">
    <div class="admin-header">
      <div><h1><%= isNew ? '新建作品' : '编辑作品' %></h1><p class="dashboard-subtitle">编辑作品介绍与展示信息</p></div>
      <button type="submit" form="work-form" class="btn-primary admin-mobile-save"><i class="ti ti-device-floppy" aria-hidden="true"></i> 保存作品</button>
    </div>
    <form id="work-form" class="edit-form">
      <div class="form-main">
        <input type="text" name="title" placeholder="作品标题" aria-label="作品标题" value="<%= work ? work.title : '' %>" required class="input-title">
        <input type="text" name="slug" placeholder="URL 别名（留空自动生成）" aria-label="URL 别名" value="<%= work ? work.slug : '' %>" class="input-slug">
        <div class="form-group">
          <label for="work-description">作品摘要</label>
          <textarea id="work-description" name="description" placeholder="用于作品列表的简短介绍" rows="2"><%= work ? work.description : '' %></textarea>
        </div>
        <div class="form-group">
          <label for="content-editor">作品内容</label>
          <textarea name="content" id="content-editor"><%= work ? work.content : '' %></textarea>
        </div>
      </div>
      <div class="form-sidebar">
        <div class="form-group">
          <label><input type="checkbox" name="featured" <%= work && work.featured ? 'checked' : '' %>> 设为精选</label>
        </div>
        <div class="form-group">
          <label for="work-year">年份</label>
          <input id="work-year" type="number" name="year" value="<%= work ? work.year || '' : '' %>">
        </div>
        <div class="form-group">
          <label for="work-date">日期（格式：2026-01-15）</label>
          <input id="work-date" type="text" name="date" placeholder="2026-01-15" value="<%= work ? work.date || '' : '' %>">
        </div>
        <div class="form-group">
          <label for="work-tags">标签（逗号分隔）</label>
          <input id="work-tags" type="text" name="tags" value="<%= work ? work.tags.join(', ') : '' %>">
        </div>
        <div class="form-group">
          <label for="work-url">外部链接</label>
          <input id="work-url" type="url" name="url" value="<%= work ? work.url : '' %>">
        </div>
        <div class="form-group">
          <label for="cover-upload">封面图片</label>
          <% if (work && work.cover_image) { %>
            <img src="<%= work.cover_image %>" class="preview-img">
          <% } %>
          <input type="file" id="cover-upload" accept="image/*">
        </div>
        <button type="submit" class="btn-primary btn-block"><i class="ti ti-device-floppy"></i> 保存作品</button>
        <% if (work) { %>
          <a href="/works/<%= work.slug %>" target="_blank" rel="noopener" class="btn-link">查看作品</a>
          <button type="button" class="btn-danger btn-sm" onclick="deleteWork(<%= work.id %>)">删除</button>
        <% } %>
      </div>
    </form>
  </main>
  <script src="<%= asset('/vendor/easymde/easymde.min.js') %>"></script>
  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
