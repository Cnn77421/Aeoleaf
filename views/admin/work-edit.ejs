<% const isNew = !work; %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <a href="/">aeoleaf <span>风叶</span></a>
    </div>
    <nav class="admin-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/posts">Posts</a>
      <a href="/admin/works">Works</a>
      <a href="/admin/visitors">Visitors</a>
      <a href="/admin/settings">Settings</a>
    </nav>
    <div class="admin-footer">
      <a href="/" target="_blank">View Site</a>
      <form method="POST" action="/admin/logout" style="margin-top:0.5rem">
        <button type="submit" class="btn-link">Log Out</button>
      </form>
    </div>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1><%= isNew ? 'New Work' : 'Edit Work' %></h1>
    </div>
    <form id="work-form" class="edit-form">
      <div class="form-main">
        <input type="text" name="title" placeholder="Title" value="<%= work ? work.title : '' %>" required class="input-title">
        <input type="text" name="slug" placeholder="slug-auto-generated" value="<%= work ? work.slug : '' %>" class="input-slug">
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" placeholder="Short description for preview" rows="2"><%= work ? work.description : '' %></textarea>
        </div>
        <div class="form-group">
          <label>Content</label>
          <textarea name="content" id="content-editor"><%= work ? work.content : '' %></textarea>
        </div>
      </div>
      <div class="form-sidebar">
        <div class="form-group">
          <label><input type="checkbox" name="featured" <%= work && work.featured ? 'checked' : '' %>> Featured</label>
        </div>
        <div class="form-group">
          <label>Year</label>
          <input type="number" name="year" value="<%= work ? work.year || '' : '' %>">
        </div>
        <div class="form-group">
          <label>Date (显示格式: 2026-01-15)</label>
          <input type="text" name="date" placeholder="2026-01-15" value="<%= work ? work.date || '' : '' %>">
        </div>
        <div class="form-group">
          <label>Tags</label>
          <input type="text" name="tags" value="<%= work ? work.tags.join(', ') : '' %>">
        </div>
        <div class="form-group">
          <label>External URL</label>
          <input type="url" name="url" value="<%= work ? work.url : '' %>">
        </div>
        <div class="form-group">
          <label>Cover Image</label>
          <% if (work && work.cover_image) { %>
            <img src="<%= work.cover_image %>" class="preview-img">
          <% } %>
          <input type="file" id="cover-upload" accept="image/*">
        </div>
        <button type="submit" class="btn-primary btn-block">Save</button>
        <% if (work) { %>
          <a href="/works/<%= work.slug %>" target="_blank" class="btn-link">View Work</a>
          <button type="button" class="btn-danger btn-sm" onclick="deleteWork(<%= work.id %>)">Delete</button>
        <% } %>
      </div>
    </form>
    <script>
    window.__AEOL_ADMIN_CTX = { workId: <%= work ? work.id : 'null' %>, postId: null };
    </script>
  </main>
  <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/editor.js"></script>
</body>
</html>
