<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <%- include('partials/styles') %>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'audit' }) %>
  <main class="admin-main">
    <div class="admin-header">
      <div><h1>操作审计</h1><p class="dashboard-subtitle">追踪登录、内容修改和高风险操作</p></div>
    </div>
    <form class="admin-filter-bar" method="get" action="/admin/audit">
      <label><span>操作</span><input type="search" name="action" value="<%= filters.action %>" placeholder="例如 post.update"></label>
      <label><span>结果</span><select name="outcome"><option value="">全部</option><option value="success" <%= filters.outcome === 'success' ? 'selected' : '' %>>成功</option><option value="failure" <%= filters.outcome === 'failure' ? 'selected' : '' %>>失败</option></select></label>
      <label><span>对象</span><select name="entity_type"><option value="">全部</option><% entityTypes.forEach(function(type) { %><option value="<%= type %>" <%= filters.entityType === type ? 'selected' : '' %>><%= type %></option><% }) %></select></label>
      <label><span>开始日期</span><input type="date" name="date_from" value="<%= filters.dateFrom %>"></label>
      <label><span>结束日期</span><input type="date" name="date_to" value="<%= filters.dateTo %>"></label>
      <button type="submit" class="btn-secondary">筛选</button>
    </form>
    <section class="admin-card">
      <div class="table-responsive">
        <table class="table admin-table">
          <thead><tr><th>时间</th><th>操作</th><th>对象</th><th>结果</th><th>来源</th><th>摘要</th></tr></thead>
          <tbody>
          <% entries.forEach(function(entry) { %>
            <tr>
              <td><%= entry.created_at %></td>
              <td><code><%= entry.action %></code></td>
              <td><%= entry.entity_type || '—' %><%= entry.entity_id ? ' #' + entry.entity_id : '' %></td>
              <td><span class="badge <%= entry.outcome === 'success' ? 'bg-success-lt' : 'bg-danger-lt' %>"><%= entry.outcome === 'success' ? '成功' : '失败' %></span></td>
              <td><span><%= entry.ip || '—' %></span><small class="d-block text-secondary"><%= (entry.user_agent || '').slice(0, 48) %></small></td>
              <td><button type="button" class="btn-secondary btn-sm" data-audit-detail data-id="<%= entry.id %>" data-action="<%= entry.action %>" data-entity="<%= entry.entity_type %> #<%= entry.entity_id %>" data-outcome="<%= entry.outcome %>" data-time="<%= entry.created_at %>" data-ip="<%= entry.ip %>" data-agent="<%= entry.user_agent %>" data-request="<%= entry.request_id %>" data-summary="<%= JSON.stringify(entry.summary) %>">查看详情</button></td>
            </tr>
          <% }) %>
          <% if (!entries.length) { %><tr><td colspan="6" class="text-center text-secondary">暂无审计记录</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </section>
    <button class="audit-drawer-backdrop" type="button" data-audit-close hidden aria-label="关闭详情"></button>
    <aside class="audit-drawer" data-audit-drawer aria-label="审计详情" aria-hidden="true">
      <header><div><small>审计记录</small><h2 data-audit-title>详情</h2></div><button type="button" class="admin-icon-button" data-audit-close aria-label="关闭"><i class="ti ti-x"></i></button></header>
      <dl><dt>对象</dt><dd data-audit-entity></dd><dt>结果</dt><dd data-audit-outcome></dd><dt>时间</dt><dd data-audit-time></dd><dt>IP</dt><dd data-audit-ip></dd><dt>Request ID</dt><dd data-audit-request></dd><dt>User-Agent</dt><dd data-audit-agent></dd><dt>变更摘要</dt><dd><pre data-audit-summary></pre></dd></dl>
    </aside>
  </main>
  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
