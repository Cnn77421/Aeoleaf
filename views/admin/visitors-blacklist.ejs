<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <%- include('partials/styles') %>
</head>
<body class="admin-body">
  <%- include('partials/sidebar', { activePage: 'visitors' }) %>

  <main class="admin-main">
    <div class="breadcrumb">
      <a href="/admin/visitors">访客列表</a>
      <span class="sep">/</span>
      <span>IP 黑名单</span>
    </div>

    <div class="admin-header">
      <h1>IP 黑名单</h1>
      <a href="/admin/visitors" class="btn-link">返回列表</a>
    </div>

    <div class="recent-section" style="margin-bottom:1.5rem">
      <h2>手动添加</h2>
      <form data-blacklist-form style="display:flex;gap:0.5rem;align-items:end;flex-wrap:wrap">
        <label class="visitors-field">IP 地址<input type="text" id="bl-ip" name="ip" class="input" placeholder="1.2.3.4" required></label>
        <label class="visitors-field">原因<input type="text" id="bl-reason" name="reason" class="input" placeholder="可选"></label>
        <button type="submit" class="btn visitors-filter-btn">添加</button>
      </form>
    </div>

    <div class="recent-section visitors-table-section">
      <div class="visitors-table-wrap">
        <table class="admin-table visitors-table visitors-table-compact">
          <thead>
            <tr>
              <th>ID</th>
              <th>IP</th>
              <th>原因</th>
              <th>添加时间</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% if (!list || list.length === 0) { %>
              <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:2rem">黑名单为空</td></tr>
            <% } else { %>
              <% list.forEach(function(row) { %>
                <tr>
                  <td><%= row.id %></td>
                  <td><%= row.ip %></td>
                  <td><%= row.reason || '—' %></td>
                  <td><%= row.created_at %></td>
                  <td>
                    <button class="btn-link" type="button" data-blacklist-remove data-ip="<%= row.ip || '' %>">移除</button>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script src="<%= asset('/js/toast.js') %>"></script>
  <script src="<%= asset('/js/admin.js') %>"></script>
</body>
</html>
