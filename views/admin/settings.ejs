<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <a href="/">aeoleaf <span>风叶</span></a>
    </div>
    <nav class="admin-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/posts">Posts</a>
      <a href="/admin/works">Works</a>
      <a href="/admin/visitors">Visitors</a>
      <a href="/admin/settings">Settings</a>
    </nav>
    <div class="admin-footer">
      <a href="/" target="_blank">View Site</a>
      <form method="POST" action="/admin/logout" style="margin-top:0.5rem">
        <button type="submit" class="btn-link">Log Out</button>
      </form>
    </div>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1>Settings</h1>
    </div>
    <% if (typeof notice !== 'undefined' && notice) { %>
    <div class="admin-notice admin-notice--ok" role="status"><%= notice %></div>
    <% } %>
    <% if (typeof saveError !== 'undefined' && saveError) { %>
    <div class="admin-notice admin-notice--err" role="alert"><%= saveError %></div>
    <% } %>
    <form method="POST" action="/admin/settings" class="settings-form" accept-charset="UTF-8">
      <div class="form-group">
        <label>Site Title</label>
        <input type="text" name="site_title" value="<%= settings.site_title || '' %>">
      </div>
      <div class="form-group">
        <label>Site Subtitle</label>
        <input type="text" name="site_subtitle" value="<%= settings.site_subtitle || '' %>">
      </div>
      <div class="form-group">
        <label>About Text (Markdown)</label>
        <textarea name="about_text" rows="10"><%= settings.about_text || '' %></textarea>
      </div>
      <div class="form-group">
        <label>About Image URL</label>
        <input type="text" name="about_image" value="<%= settings.about_image || '' %>">
      </div>
      <div class="form-group">
        <label>About 页副标题（留空则用站点副标题）</label>
        <input type="text" name="about_tagline" value="<%= settings.about_tagline || '' %>" placeholder="一句话介绍自己或本站">
      </div>
      <div class="form-group">
        <label>About 页 SEO / 分享摘要（留空则从 About 正文截取）</label>
        <textarea name="about_meta" rows="2" placeholder="用于 meta description 与 Open Graph"><%= settings.about_meta || '' %></textarea>
      </div>
      <div class="form-group">
        <label>联系邮箱</label>
        <input type="text" name="contact_email" value="<%= settings.contact_email || '' %>" placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label>QQ</label>
        <input type="text" name="contact_qq" value="<%= settings.contact_qq || '' %>" placeholder="选填">
      </div>
      <div class="form-group">
        <label>社交链接（JSON 数组）</label>
        <textarea name="social_links" rows="5" placeholder='[{"label":"GitHub","url":"https://github.com/..."}]'><%= settings.social_links || '[]' %></textarea>
        <p class="form-hint">每项包含 label 与 url；url 仅支持 http(s)、mailto: 或以 / 开头的站内路径。</p>
      </div>
      <button type="submit" class="btn-primary">Save Settings</button>
    </form>
  </main>
  <script src="/js/toast.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
