<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <%- include('partials/styles') %>
</head>
<body class="admin-login-body">
  <div class="login-container">
    <div class="login-card">
      <div class="login-mobile-brand"><span class="admin-logo-mark"><i class="ti ti-leaf"></i></span> Aeoleaf</div>
      <div class="login-heading">
        <h1>登录后台</h1>
        <p>输入管理员密码以继续</p>
      </div>
      <% if (error) { %>
      <p class="error-message"><%= error %></p>
      <% } %>
      <form method="POST" action="/admin/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="admin-password">管理员密码</label>
        <input id="admin-password" type="password" name="password" placeholder="请输入密码" aria-label="管理员密码" autocomplete="current-password" required autofocus>
        <button type="submit" class="btn-primary">登录</button>
      </form>
      <% if (passkeyCount > 0) { %>
      <div class="login-divider"><span>或</span></div>
      <button type="button" class="btn-secondary btn-block" data-passkey-login><i class="ti ti-key"></i> 使用通行密钥登录</button>
      <% } %>
      <p class="login-footnote">受安全会话和 CSRF 防护保护</p>
    </div>
    <div class="login-brand-panel" aria-hidden="true">
      <div class="login-brand-mark"><i class="ti ti-leaf"></i></div>
      <div>
        <strong>Aeoleaf</strong>
        <p>在一处管理内容、作品与访客数据。</p>
      </div>
      <blockquote>“写作是在时间里种下一片叶子。”</blockquote>
    </div>
  </div>
  <script src="<%= asset('/vendor/simplewebauthn-browser.min.js') %>"></script>
  <script src="<%= asset('/js/passkeys.js') %>"></script>
</body>
</html>
