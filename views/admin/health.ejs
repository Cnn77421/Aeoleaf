<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= title %></title><%- include('partials/styles') %></head>
<body class="admin-body"><%- include('partials/sidebar', { activePage: 'health' }) %><main class="admin-main">
<div class="admin-header"><div><h1>系统健康</h1><p class="dashboard-subtitle">数据库、磁盘、上传、备份、运行时与安全配置诊断</p></div><a class="btn-secondary" href="/admin/health"><i class="ti ti-refresh"></i> 重新检查</a></div>
<section class="health-summary"><article class="health-ok"><small>正常</small><strong><%= health.summary.ok %></strong></article><article class="health-warning"><small>警告</small><strong><%= health.summary.warning %></strong></article><article class="health-error"><small>错误</small><strong><%= health.summary.error %></strong></article><p>检查时间：<%= new Date(health.checkedAt).toLocaleString('zh-CN') %></p></section>
<section class="health-grid"><% health.checks.forEach(check => { %><article class="health-card health-<%= check.status %>"><header><span class="health-dot"></span><div><h2><%= check.label %></h2><small><%= check.id %></small></div><span class="badge"><%= check.status === 'ok' ? '正常' : check.status === 'warning' ? '警告' : '错误' %></span></header><strong><%= check.message %></strong><p><%= check.detail %></p></article><% }) %></section>
<section class="analytics-card health-history"><header class="analytics-card-header"><div><h2>自动检查记录</h2><p>每 5 分钟保存一次，状态变化时发送通知</p></div></header><div class="analytics-card-content"><% if (!history.length) { %><p class="empty-state">等待首次自动检查</p><% } else { %><div class="health-history-list"><% history.forEach(item => { %><span class="health-<%= item.status %>" title="正常 <%= item.ok_count %> · 警告 <%= item.warning_count %> · 错误 <%= item.error_count %>"><i></i><time><%= item.created_at %></time></span><% }) %></div><% } %></div></section>
</main><script src="<%= asset('/js/toast.js') %>"></script><script src="<%= asset('/js/admin.js') %>"></script></body></html>
