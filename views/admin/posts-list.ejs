<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <a href="/">aeoleaf <span>风叶</span></a>
    </div>
    <nav class="admin-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/posts">Posts</a>
      <a href="/admin/works">Works</a>
      <a href="/admin/settings">Settings</a>
    </nav>
    <div class="admin-footer">
      <a href="/" target="_blank">View Site</a>
      <form method="POST" action="/admin/logout" style="margin-top:0.5rem">
        <button type="submit" class="btn-link">Log Out</button>
      </form>
    </div>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1>Posts</h1>
      <a href="/admin/posts/new" class="btn-primary">New Post</a>
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (posts.length === 0) { %>
        <tr><td colspan="4" class="empty-state">No posts yet</td></tr>
        <% } else { %>
          <% posts.forEach(post => { %>
          <tr>
            <td><a href="/blog/<%= post.slug %>" target="_blank"><%= post.title %></a></td>
            <td><span class="badge badge-<%= post.status %>"><%= post.status %></span></td>
            <td><%= new Date(post.created_at).toLocaleDateString() %></td>
            <td>
              <a href="/admin/posts/<%= post.id %>/edit" class="btn-sm">Edit</a>
              <button class="btn-sm btn-danger" onclick="deletePost(<%= post.id %>)">Delete</button>
            </td>
          </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </main>
  <script src="/js/toast.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
