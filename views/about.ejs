<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: title,
  description: (locals.ogDescription != null && String(locals.ogDescription)) ? locals.ogDescription : '关于我 — 个人博客与作品集',
  canonicalPath: '/about',
  ogImagePath: locals.aboutImage || '/images/logo.png',
  twitterCard: 'summary',
  extraCss: ['/css/about-v2.css']
}) %>
</head>
<body class="about-v2">
  <%- include('partials/public-header') %>
  <main id="main" class="site-main">
    <div class="ab-shell">

      <!-- Hero -->
      <header class="ab-hero ab-reveal">
        <p class="ab-hero__label">About</p>
        <h1 class="ab-hero__title">关于</h1>
        <p class="ab-hero__desc"><%= locals.aboutHeroLine != null && String(locals.aboutHeroLine) ? locals.aboutHeroLine : '个人博客与作品集' %></p>
      </header>

      <div class="ab-divider ab-reveal"></div>

      <!-- Profile: avatar + about text -->
      <section class="ab-profile ab-reveal" aria-label="个人简介">
        <div class="ab-profile__avatar">
          <% if (locals.aboutImage) { %>
          <img src="<%= locals.aboutImage %>" alt="">
          <% } else { %>
          <div class="ab-profile__avatar-placeholder" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <% } %>
        </div>
        <div class="ab-profile__body">
          <div class="ab-profile__prose">
            <% if (locals.aboutText) { %>
              <%- locals.aboutText %>
            <% } else { %>
              <p>Welcome to aeoleaf. 在后台 <strong>Settings</strong> 中填写 About 文本（支持 Markdown）即可展示你的介绍。</p>
            <% } %>
          </div>
        </div>
      </section>

      <div class="ab-divider ab-reveal"></div>

      <!-- Stats -->
      <% var _stats = (typeof statsData !== 'undefined' && statsData) ? statsData : { postsCount: 0, worksCount: 0, totalPV: 0 }; %>
      <section class="ab-stats ab-reveal" aria-label="站点数据">
        <div class="ab-stat">
          <span class="ab-stat__num" data-target="<%= _stats.postsCount %>">0</span>
          <span class="ab-stat__label">文章</span>
        </div>
        <div class="ab-stat">
          <span class="ab-stat__num" data-target="<%= _stats.worksCount %>">0</span>
          <span class="ab-stat__label">作品</span>
        </div>
        <div class="ab-stat">
          <span class="ab-stat__num" data-target="<%= _stats.totalPV %>">0</span>
          <span class="ab-stat__label">访问记录</span>
        </div>
      </section>

      <div class="ab-divider ab-reveal"></div>

      <!-- Contact -->
      <% var _ce = locals.contactEmail != null ? String(locals.contactEmail) : ''; %>
      <% var _cq = locals.contactQq != null ? String(locals.contactQq) : ''; %>
      <% var _sl = Array.isArray(locals.socialLinks) ? locals.socialLinks : []; %>
      <% var _hasContact = Boolean((_ce && _ce.trim()) || (_cq && _cq.trim()) || _sl.length); %>
      <section class="ab-reveal" aria-label="联系方式">
        <p class="ab-contact__label">联系与社交</p>
        <% if (_hasContact) { %>
        <div class="ab-contact__list">
          <% if (_ce && _ce.trim()) { %>
          <a href="mailto:<%= _ce.trim() %>" class="ab-contact__item">
            <span class="ab-contact__key">Email</span>
            <span class="ab-contact__val"><%= _ce.trim() %></span>
            <span class="ab-contact__arrow">↗</span>
          </a>
          <% } %>
          <% if (_cq && _cq.trim()) { %>
          <div class="ab-contact__item">
            <span class="ab-contact__key">QQ</span>
            <span class="ab-contact__val"><%= _cq.trim() %></span>
            <span class="ab-contact__arrow"></span>
          </div>
          <% } %>
          <% _sl.forEach(function(s) { %>
          <a href="<%= s.url %>" class="ab-contact__item" rel="noopener noreferrer" target="_blank">
            <span class="ab-contact__key"><%= s.label %></span>
            <span class="ab-contact__val"><%= s.url.replace(/^https?:\/\//, '') %></span>
            <span class="ab-contact__arrow">↗</span>
          </a>
          <% }); %>
        </div>
        <% } else { %>
        <p class="ab-contact__empty">尚未填写联系方式。可在后台 <strong>Settings</strong> 中设置。</p>
        <% } %>
      </section>

      <div class="ab-divider ab-reveal"></div>

      <!-- Explore -->
      <section class="ab-explore ab-reveal" aria-label="站内一览">
        <div>
          <p class="ab-explore__label">最近文章</p>
          <% var _rp = Array.isArray(locals.recentPosts) ? locals.recentPosts : []; %>
          <% if (_rp.length) { %>
          <ul class="ab-explore__list">
            <% _rp.forEach(function(p) { %>
            <li>
              <a href="/blog/<%= p.slug %>"><%= p.title %></a>
              <time datetime="<%= p.created_at %>"><%= new Date(p.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }) %></time>
            </li>
            <% }); %>
          </ul>
          <a href="/blog" class="ab-explore__more">全部文章 →</a>
          <% } else { %>
          <p class="ab-explore__empty">暂无已发布文章。</p>
          <% } %>
        </div>
        <div>
          <p class="ab-explore__label">精选作品</p>
          <% var _fw = Array.isArray(locals.featuredWorks) ? locals.featuredWorks : []; %>
          <% if (_fw.length) { %>
          <ul class="ab-explore__list">
            <% _fw.forEach(function(w) { %>
            <li>
              <a href="/works/<%= w.slug %>"><%= w.title %></a>
              <% if (w.description) { %><span class="ab-explore__desc"><%= w.description %></span><% } %>
            </li>
            <% }); %>
          </ul>
          <a href="/works" class="ab-explore__more">全部作品 →</a>
          <% } else { %>
          <p class="ab-explore__empty">暂无精选作品。</p>
          <% } %>
        </div>
      </section>

    </div>
  </main>
  <%- include('partials/public-footer', {
    contactEmail: locals.contactEmail,
    contactQq: locals.contactQq,
    socialLinks: locals.socialLinks
  }) %>

  <script>
  (function () {
    // Scroll-triggered entrance animation
    var els = document.querySelectorAll('.ab-reveal');
    if (!els.length) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08 });
    els.forEach(function (el) { io.observe(el); });

    // Stats counter animation
    var counters = document.querySelectorAll('.ab-stat__num[data-target]');
    var counterIo = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target;
        var target = parseInt(el.getAttribute('data-target'), 10) || 0;
        if (target === 0) { el.textContent = '0'; counterIo.unobserve(el); return; }
        var duration = 900;
        var start = performance.now();
        function tick(now) {
          var p = Math.min(1, (now - start) / duration);
          var ease = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(ease * target).toLocaleString();
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        counterIo.unobserve(el);
      });
    }, { threshold: 0.5 });
    counters.forEach(function (el) { counterIo.observe(el); });
  })();
  </script>
</body>
</html>
