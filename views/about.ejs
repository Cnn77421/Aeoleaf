<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="关于我 - 了解更多关于 aeoleaf 的信息">
  <meta name="keywords" content="关于,个人简介,联系方式">
  <meta name="author" content="aeoleaf">
  <meta name="theme-color" content="#3A7D44">
  <link rel="canonical" href="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %>/about">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="关于我 - 了解更多关于 aeoleaf 的信息">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %>/about">
  <% if (aboutImage) { %>
  <meta property="og:image" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %><%= aboutImage %>">
  <% } else { %>
  <meta property="og:image" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %>/images/logo.png">
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="关于我 - 了解更多关于 aeoleaf 的信息">
  <% if (aboutImage) { %>
  <meta name="twitter:image" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %><%= aboutImage %>">
  <% } else { %>
  <meta name="twitter:image" content="<%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %>/images/logo.png">
  <% } %>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lora:ital,wght@0,400;1,400&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css?v=4">
</head>
<body>
  <header class="site-header">
    <nav class="nav-container">
      <a href="/" class="nav-logo">Aeoleaf <span class="nav-logo-zh">风叶</span></a>
      <div class="nav-right">
        <ul class="nav-links">
          <li><a href="/blog">Blog</a></li>
          <li><a href="/works">Works</a></li>
          <li><a href="/about">About</a></li>
        </ul>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </nav>
  </header>
  <main class="site-main">
    <div class="content-container about-page">
      <h1>About</h1>
      <div class="about-content">
        <% if (aboutImage) { %>
        <img src="<%= aboutImage %>" alt="About" class="about-image">
        <% } %>
        <div class="prose">
          <% if (aboutText) { %>
            <%- aboutText %>
          <% } else { %>
            <p>Welcome to aeoleaf.</p>
          <% } %>
        </div>
        <div class="contact-info">
          <h2>Contact</h2>
          <p><strong>Email:</strong> <a href="mailto:xiner521@aliyun.com">xiner521@aliyun.com</a></p>
          <p><strong>QQ:</strong> 2727639066</p>
        </div>
      </div>
    </div>
  </main>
  <footer class="site-footer">
    <div class="footer-content">
      <div class="footer-section">
        <h3>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
          </svg>
          aeoleaf 风叶
        </h3>
        <p>个人博客与作品集</p>
      </div>
      <div class="footer-section">
        <h3>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          导航
        </h3>
        <ul>
          <li><a href="/">首页</a></li>
          <li><a href="/blog">博客</a></li>
          <li><a href="/works">作品</a></li>
          <li><a href="/about">关于</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          联系
        </h3>
        <ul>
          <li>
            <a href="mailto:xiner521@aliyun.com">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
              </svg>
              邮箱
            </a>
          </li>
          <li>
            <a href="https://github.com/Cnn77421" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> aeoleaf. All rights reserved.</p>
      <p><a href="/admin/login" style="opacity:0;font-size:0;user-select:none;">.</a></p>
    </div>
  </footer>
  <button id="back-to-top" aria-label="Back to top">↑</button>
  <script src="/js/main.js"></script>
  <script src="/js/tracker.js" async defer></script>
</body>
</html>
