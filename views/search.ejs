<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: title,
  description: '在 aeoleaf 搜索文章和作品',
  canonicalPath: '/search',
  twitterCard: 'summary',
  noIndex: true,
  extraCss: ['/css/public-pages.css']
}) %>
</head>
<body class="search-page">
  <%- include('partials/public-header') %>
  <main id="main" class="site-main">
    <div class="content-container">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span class="breadcrumb-separator" aria-hidden="true">›</span>
        <span class="breadcrumb-current">搜索</span>
      </nav>
      <h1>搜索</h1>
      <div class="search-box search-box--page">
        <label for="search-page-input" class="visually-hidden">搜索关键词</label>
        <input type="text" id="search-page-input" placeholder="搜索文章和作品..." value="<%= query || '' %>" autocomplete="off">
        <button id="search-page-btn" type="button" class="btn-primary">搜索</button>
      </div>
      <div id="search-page-results" role="region" aria-live="polite"></div>
    </div>
  </main>
  <%- include('partials/public-footer') %>
  <script src="<%= asset('/js/search.js') %>"></script>
</body>
</html>
