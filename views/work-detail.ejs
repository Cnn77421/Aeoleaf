<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('partials/public-head', {
  title: work.title + ' — aeoleaf',
  description: work.description || work.title,
  canonicalPath: '/works/' + work.slug,
  ogType: 'article',
  ogImagePath: work.cover_image || '/images/logo.png',
  twitterCard: 'summary_large_image',
  extraCss: ['/css/work-detail-v2.css']
}) %>
  <% if (work.cover_image) { %>
  <link rel="preload" as="image" href="<%= work.cover_image %>" fetchpriority="high">
  <% } %>
  <%
    var _baseUrl = typeof baseUrl !== 'undefined' && baseUrl ? baseUrl : 'http://localhost:3000';
    var _ld = {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: work.title,
      description: work.description || work.title,
      url: _baseUrl + '/works/' + work.slug,
      keywords: (work.tags || []).join(', '),
      author: { '@type': 'Person', name: 'aeoleaf' },
      dateCreated: work.date || work.created_at || null
    };
    if (work.cover_image) _ld.image = (work.cover_image.indexOf('http') === 0) ? work.cover_image : _baseUrl + work.cover_image;
    if (work.url) _ld.sameAs = work.url;
  %>
  <script type="application/ld+json"><%- JSON.stringify(_ld) %></script>
</head>
<body>
  <%- include('partials/public-header') %>
  <main id="main" class="site-main">

    <nav class="wd-breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span class="wd-breadcrumb__sep" aria-hidden="true">›</span>
      <a href="/works">作品</a>
      <span class="wd-breadcrumb__sep" aria-hidden="true">›</span>
      <span class="wd-breadcrumb__current"><%= work.title %></span>
    </nav>

    <!-- Hero -->
    <div class="wd-hero<%= work.cover_image ? '' : ' wd-hero--mono' %>">
      <% if (work.cover_image) { %>
      <img src="<%= work.cover_image %>" alt="<%= work.title %>" class="wd-hero__img">
      <% } %>
      <div class="wd-hero__overlay">
        <div class="wd-hero__eyebrow">
          <span class="wd-hero__dot"></span>
          <% if (work.year) { %><span><%= work.year %></span><% } %>
          <% if (work.tags && work.tags.length) { %><span><%= work.tags[0] %></span><% } %>
        </div>
        <h1 class="wd-hero__title"><%= work.title %></h1>
        <% if (work.description) { %>
        <p class="wd-hero__desc"><%= work.description %></p>
        <% } %>
      </div>
    </div>

    <!-- Body -->
    <div class="wd-body">

      <!-- Main content -->
      <div class="wd-content">
        <% if (work.images && work.images.length > 0) { %>
        <div class="wd-images">
          <% work.images.forEach(img => { %>
          <img src="<%= img %>" alt="<%= work.title %>" loading="lazy">
          <% }); %>
        </div>
        <% } %>
        <% if (work.html) { %>
        <div class="prose"><%- work.html %></div>
        <% } %>
      </div>

      <!-- Sidebar -->
      <aside class="wd-sidebar">
        <% if (work.tags && work.tags.length > 0) { %>
        <div class="wd-meta-card">
          <span class="wd-meta-card__label">标签</span>
          <div class="wd-tags">
            <% work.tags.forEach(tag => { %><span class="wd-tag"><%= tag %></span><% }); %>
          </div>
        </div>
        <% } %>

        <% if (work.year) { %>
        <div class="wd-meta-card">
          <span class="wd-meta-card__label">年份</span>
          <span class="wd-meta-card__value"><%= work.year %></span>
        </div>
        <% } %>

        <% if (work.url) { %>
        <a href="<%= work.url %>" target="_blank" rel="noopener noreferrer" class="wd-cta">
          访问项目 ↗
        </a>
        <% } %>
      </aside>

    </div>
  </main>
  <%- include('partials/public-footer') %>
</body>
</html>
